# Envío del formulario de cotización con Resend (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Remitente con un dominio verificado en Resend
RESEND_FROM="Tenax Construction <cotizaciones@tenaxconstruction.com.do>"
# Buzón que recibe las solicitudes de cotización
QUOTE_TO_EMAIL=tenaxconstructionsrl@gmail.com

# Anti-bots del formulario con Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile).
# Estas son las claves de prueba de Cloudflare: siempre pasan y sirven en localhost.
# En Vercel van las del widget real; la pública se lee al compilar, así que hay que redesplegar al cambiarla.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
