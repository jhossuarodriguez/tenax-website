---
import '@/styles/global.css';
import { site } from '@/data/site';
import { breadcrumbSchema, siteSchema } from '@/data/schema';
import type { SeoMeta } from '@/types';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import FloatingWidgets from '@/components/layout/FloatingWidgets.astro';

type Props = SeoMeta;

const { title, description = site.description, breadcrumbs, schema, noindex = false } = Astro.props;
const fullTitle = title === site.name ? title : `${title} | ${site.name}`;

// `site` viene de astro.config.mjs; sin él no hay URL absolutas para el canónico ni para Open Graph.
const base = Astro.site!;
const canonical = new URL(Astro.url.pathname, base).href;
const ogImage = new URL(site.ogImage, base).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [...siteSchema(base), ...(breadcrumbs ? [breadcrumbSchema(breadcrumbs, base)] : []), ...(schema ? [schema] : [])],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="es_DO" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="icon" href={site.favicon.small} sizes="32x32" />
    <link rel="icon" href={site.favicon.large} sizes="192x192" />
    <link rel="apple-touch-icon" href={site.favicon.apple} />

    <!--
      Fuentes locales (@font-face en global.css). Solo se precargan las del encabezado y el hero, que se ven
      al abrir cualquier página: texto (Work Sans 400), botón de cotización (500), menú (Kanit 400) y H1 (700).
      Las demás llegan con el CSS; precargar las siete competía con la imagen principal.
    -->
    <link rel="preload" href="/fonts/work-sans-v24-latin-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/work-sans-v24-latin-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/kanit-v17-latin-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/kanit-v17-latin-700.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Activa el reveal antes del primer pintado para que no parpadee el contenido. -->
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js-reveal');
      }
    </script>
  </head>
  <body>
    <a href="#content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-white focus:p-2">
      Ir al contenido
    </a>
    <Header />
    <main id="content">
      <slot />
    </main>
    <Footer />
    <FloatingWidgets />

    <!-- Scripts separados: si uno falla al cargar, el otro sigue funcionando. -->
    <script>
      import '@/scripts/reveal';
    </script>
    <script>
      import '@/scripts/lazy-bg';
    </script>
  </body>
</html>
