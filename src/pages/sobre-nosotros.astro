---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageBanner from '@/components/shared/PageBanner.astro';
import AboutIntro from '@/components/about/AboutIntro.astro';
import AboutFeatureRowBlock from '@/components/about/AboutFeatureRow.astro';
import AboutFaq from '@/components/about/AboutFaq.astro';
import AboutSafety from '@/components/about/AboutSafety.astro';
import HomeVision from '@/components/home/HomeVision.astro';
import { home } from '@/data/home';
import { aboutPage } from '@/data/about';
---

<BaseLayout title={aboutPage.seo.title} description={aboutPage.seo.description} breadcrumbs={aboutPage.hero.breadcrumbs}>
  <!-- Diseño de Tenax en Canva (pág. 18): banner y "Somos Tenax" con el formato de severfield.com/about. -->
  <PageBanner banner={aboutPage.hero} />
  <AboutIntro data={aboutPage.intro} breadcrumbs={aboutPage.hero.breadcrumbs} />

  <div class="pt-[1.6rem]">
    {aboutPage.rows.map((row) => <AboutFeatureRowBlock row={row} />)}
    <!-- Trayectoria: la misma visión, cifras y valores de la portada. -->
    <div id="trayectoria" class="mt-[1.6rem] scroll-mt-[20px]">
      <HomeVision data={home.vision} />
    </div>
    <AboutSafety data={aboutPage.safety} />
    <div class="mt-[1.6rem]">
      <AboutFaq title={aboutPage.faqTitle} items={aboutPage.faqs} />
    </div>
  </div>

</BaseLayout>
