---
import Layout from '@/layouts/Layout.astro'

export const prerender = true

const canonical = 'https://tenaxconstruction.com.do/404'
---

<Layout canonical={canonical} noindex={true}>
  <section
    class="relative mx-auto flex w-full min-h-screen flex-col items-center justify-center bg-[url('/about-bg.webp')] bg-cover bg-center bg-no-repeat"
  >
    <div class="absolute inset-0 z-0 bg-obsidian/85"></div>

    <div class="page-reveal relative z-10 flex flex-col items-center px-4 text-center md:px-6 lg:px-8">
      <p class="mb-3 font-mono text-xs uppercase tracking-[0.18em] text-ash md:text-sm">Error 404</p>
      <h1 class="mb-4 font-display text-4xl leading-[0.95] text-cloud md:text-6xl">
        Página no encontrada
      </h1>
      <p class="mb-8 max-w-xl text-base text-ash md:text-lg">
        La página que estás buscando no existe, fue movida o su URL es incorrecta.
      </p>

      <div class="flex flex-col gap-3 sm:flex-row">
        <a
          href="/"
          class="rounded-lg bg-pure px-6 py-3 font-sans font-medium text-void"
          title="Volver a la página de inicio"
          aria-label="Volver a la página de inicio"
        >
          ← Volver al inicio
        </a>
        <a
          href="/contacto"
          class="rounded-lg border border-white/40 px-6 py-3 font-sans font-medium text-pure hover:bg-white/10"
          title="Ir a la página de contacto"
          aria-label="Ir a la página de contacto"
        >
          Contactar con Tenax
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { revealOnScroll } from '@/lib/motion'
  revealOnScroll('.page-reveal', { start: 'top 95%' })
</script>
