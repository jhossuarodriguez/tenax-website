---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada" noindex>
  <section class="bg-grid-ink relative overflow-hidden bg-ink">
    <div class="relative mx-auto max-w-[760px] px-6 py-28 text-center">
      <p class="mb-4 font-mono text-[0.76rem] font-semibold tracking-[0.05em] text-brand uppercase">// Error 404</p>
      <h1 class="mb-5 font-display text-[clamp(2.1rem,4.8vw,3.4rem)] leading-[1.12] font-bold text-cream">Página no encontrada</h1>
      <p class="mx-auto mb-8 max-w-[560px] text-[1.05rem] leading-[1.65] text-sand">La página que estás buscando no existe, fue movida o su URL es incorrecta.</p>
      <a href="/" class="inline-block rounded-[5px] bg-brand px-6 py-3 font-display text-white transition-colors hover:bg-brand-dark hover:text-white">Volver al inicio</a>
    </div>
  </section>
</BaseLayout>
