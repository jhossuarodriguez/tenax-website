---
import Layout from '@/layouts/Layout.astro'
import Grua from '@/assets/icons/grua.svg'
import Hammer from '@/assets/icons/hammer.svg'
import DumpDumper from '@/assets/icons/dumpDumper.svg'
import Measure from '@/assets/icons/measure.svg'
import { SERVICES } from '@/components/consts/Services'

export const prerender = false

const seo = {
  canonical: 'https://www.tenaxconstruction.com.do/servicios',
  title: 'Servicios - Tenax Construction',
  description:
    'Descubre nuestros servicios de construcción: excavación, estructuras metálicas, movimiento de tierra y hormigón armado.',
}

const iconMap = {
  grua: Grua,
  hammer: Hammer,
  dumpDumper: DumpDumper,
  measure: Measure,
}

---

<Layout {...seo}>
  <section
    class="relative w-full min-h-screen py-32 bg-[url('/about-bg.webp')] bg-cover bg-center bg-no-repeat"
  >
    <div class="absolute inset-0 z-0 bg-obsidian/85"></div>

    <div class="relative z-10 mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="page-reveal mb-16 mt-14 text-center">
        <span class="font-mono text-xs uppercase tracking-[0.18em] text-ash">Lo que hacemos</span>
        <h1 class="mt-4 font-display text-3xl leading-[0.95] text-cloud md:text-[38px]">
          Nuestros Servicios
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-base text-ash md:text-lg">
          Ofrecemos soluciones integrales en construcción con los más altos estándares de calidad y
          compromiso.
        </p>
      </div>

      <div class="services-grid grid grid-cols-1 gap-6 md:grid-cols-2">
        {
          SERVICES.map((servicio, i) => {
            const IconComponent = iconMap[servicio.icon as keyof typeof iconMap]
            return (
              <a
                href={`/servicios/${servicio.id}`}
                class="service-card group block rounded-lg border border-black/10 bg-paper p-8"
              >
                <div class="mb-6 flex items-center gap-4">
                  <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-primary/10">
                    <IconComponent class="h-8 w-8 text-primary" />
                  </div>
                  <h2 class="font-display text-2xl leading-none text-ink">{servicio.titulo}</h2>
                </div>

                <p class="mb-6 leading-relaxed text-slate">{servicio.descripcionCorta}</p>

                <ul class="mb-6 space-y-2">
                  {servicio.caracteristicas.slice(0, 4).map((caracteristica) => (
                    <li class="flex items-center gap-2 text-slate">
                      <span class="h-1.5 w-1.5 rounded-full bg-primary" />
                      {caracteristica}
                    </li>
                  ))}
                </ul>

                <span class="inline-flex items-center gap-2 font-medium text-ink">
                  Ver más detalles
                  <span aria-hidden="true">→</span>
                </span>
              </a>
            )
          })
        }
      </div>

      <div class="page-reveal mt-16 text-center">
        <div class="mx-auto max-w-3xl rounded-lg border border-white/10 bg-graphite/50 p-8 backdrop-blur-md md:p-12">
          <h3 class="font-display text-2xl text-cloud md:text-3xl mb-4">
            ¿Tienes un proyecto en mente?
          </h3>
          <p class="mb-8 text-ash">
            Contáctanos para una cotización personalizada. Nuestro equipo está listo para ayudarte a
            hacer realidad tu proyecto.
          </p>
          <div class="flex flex-col justify-center gap-4 sm:flex-row">
            <a
              href="/cotizacion"
              class="inline-flex items-center justify-center gap-2 rounded-lg bg-pure px-8 py-3 font-sans text-void"
            >
              Solicitar Cotización
            </a>
            <a
              href="/contacto"
              class="inline-flex items-center justify-center gap-2 rounded-lg border border-white/30 px-8 py-3 font-sans text-pure hover:bg-white/10"
            >
              Contactar
            </a>
          </div>
        </div>
      </div>

      <div class="page-reveal mt-12 text-center">
        <a
          href="/"
          class="inline-block rounded-lg border border-white/30 px-6 py-3 font-sans text-sm text-pure hover:bg-white/10"
        >
          ← Volver al Inicio
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { revealOnScroll, staggerOnScroll } from '@/lib/motion'
  revealOnScroll('.page-reveal', { start: 'top 95%' })
  staggerOnScroll('.services-grid', '.service-card')
</script>
