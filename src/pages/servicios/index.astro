---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/shared/Breadcrumbs.astro';
import ServicesHero from '@/components/services/ServicesHero.astro';
import ServiceCard from '@/components/services/ServiceCard.astro';
import ServicesCta from '@/components/services/ServicesCta.astro';
import { services, servicesPage } from '@/data/services';

const { seo, hero, heading, intro, cta } = servicesPage;
---

<BaseLayout title={seo.title} description={seo.description} breadcrumbs={hero.breadcrumbs}>
  <ServicesHero hero={hero} />

  <section class="bg-surface-alt px-[20px] pt-[32px] pb-[60px]">
    <div class="mx-auto max-w-site">
      <Breadcrumbs items={hero.breadcrumbs} class="mb-[28px] text-center" />
      <h2 data-reveal class="mb-[12px] text-center">{heading}</h2>
      <p class="mx-auto mb-[35px] max-w-[760px] text-center leading-[1.6rem] text-[#555]">{intro}</p>
      <div data-reveal-children class="grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))] gap-[26px]">
        {services.map((service) => <ServiceCard service={service} />)}
      </div>
    </div>
  </section>

  <ServicesCta {...cta} />
</BaseLayout>
