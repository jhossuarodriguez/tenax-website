---
import type { GetStaticPaths } from 'astro'
import Layout from '@/layouts/Layout.astro'
import { SERVICES } from '@/components/consts/Services'

import Grua from '@/assets/icons/grua.svg'
import Hammer from '@/assets/icons/hammer.svg'
import DumpDumper from '@/assets/icons/dumpDumper.svg'
import Measure from '@/assets/icons/measure.svg'

const iconMap = {
  grua: Grua,
  hammer: Hammer,
  dumpDumper: DumpDumper,
  measure: Measure,
}

const { id } = Astro.params
if (!id) return Astro.redirect('/404')

const servicio = SERVICES.find((s) => s.id === id)
if (!servicio) return Astro.redirect('/404')

export const getStaticPaths = (() => {
  return SERVICES.map((servicio) => ({
    params: { id: servicio.id },
  }))
}) satisfies GetStaticPaths

export const prerender = true

const seo = {
  canonical: `https://tenaxconstruction.com.do/servicios/${id}`,
  title: `${servicio.titulo} - Servicios | Tenax Construction`,
  description: servicio.descripcionCorta,
}

const IconComponent = iconMap[servicio.icon as keyof typeof iconMap]
---

<Layout {...seo}>
  <section
    class="relative w-full min-h-screen bg-[url('/about-bg.webp')] bg-cover bg-center bg-no-repeat"
  >
    <div class="absolute inset-0 z-0 bg-obsidian/90"></div>

    <div class="relative z-10 mx-auto max-w-6xl px-4 py-32 sm:px-6 lg:px-8">
      <nav class="mb-8 mt-14">
        <ol class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.1em] text-ash">
          <li><a href="/" class="hover:text-pure">Inicio</a></li>
          <li>/</li>
          <li><a href="/servicios" class="hover:text-pure">Servicios</a></li>
          <li>/</li>
          <li class="text-pure">{servicio.titulo}</li>
        </ol>
      </nav>

      <div class="page-reveal mb-12 flex flex-col gap-8 md:flex-row">
        <div class="flex-1">
          <div class="mb-6 flex items-center gap-4">
            <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-white/10">
              <IconComponent class="h-10 w-10 text-pure" />
            </div>
            <h1 class="font-display text-3xl leading-[0.95] text-cloud md:text-[38px]">
              {servicio.titulo}
            </h1>
          </div>
          <p class="text-lg leading-relaxed text-ash">
            {servicio.descripcionLarga}
          </p>
        </div>
        <div class="md:w-96">
          <img
            src={servicio.imagen}
            alt={servicio.titulo}
            class="h-64 w-full rounded-lg object-cover md:h-80"
            loading="eager"
          />
        </div>
      </div>

      <div class="mb-12 grid grid-cols-1 gap-6 lg:grid-cols-2">
        <div class="page-reveal rounded-lg border border-white/10 bg-graphite/50 p-8">
          <h2 class="mb-6 flex items-center gap-3 font-display text-2xl text-cloud">
            <span class="h-8 w-2 rounded-full bg-primary"></span>
            Características del Servicio
          </h2>
          <ul class="space-y-3">
            {
              servicio.caracteristicas.map((caracteristica) => (
                <li class="flex items-start gap-3 text-ash">
                  <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-primary" />
                  {caracteristica}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="page-reveal rounded-lg border border-white/10 bg-graphite/50 p-8">
          <h2 class="mb-6 flex items-center gap-3 font-display text-2xl text-cloud">
            <span class="h-8 w-2 rounded-full bg-orchid-bloom"></span>
            Beneficios
          </h2>
          <ul class="space-y-3">
            {
              servicio.beneficios.map((beneficio) => (
                <li class="flex items-start gap-3 text-ash">
                  <svg class="mt-0.5 h-5 w-5 shrink-0 text-orchid-bloom" fill="currentColor" viewBox="0 0 20 20">
                    <path
                      fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd"
                    />
                  </svg>
                  {beneficio}
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="page-reveal mb-12 rounded-lg border border-white/10 bg-graphite/50 p-8">
        <h2 class="mb-8 flex items-center gap-3 font-display text-2xl text-cloud">
          <span class="h-8 w-2 rounded-full bg-periwinkle"></span>
          Proceso de Trabajo
        </h2>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
          {
            servicio.proceso.map((paso, index) => (
              <div class="relative">
                <div class="mb-3 flex items-center gap-3">
                  <span class="flex h-10 w-10 items-center justify-center rounded-full bg-pure text-lg font-bold text-void">
                    {index + 1}
                  </span>
                  <h3 class="text-lg font-semibold text-cloud">{paso.paso}</h3>
                </div>
                <p class="pl-13 text-sm leading-relaxed text-ash">{paso.descripcion}</p>
                {index < servicio.proceso.length - 1 && (
                  <div class="absolute top-5 left-[calc(100%+0.5rem)] hidden h-0.5 w-8 bg-white/20 lg:block" />
                )}
              </div>
            ))
          }
        </div>
      </div>

      {
        servicio.equipos && (
          <div class="page-reveal mb-12 rounded-lg border border-white/10 bg-graphite/50 p-8">
            <h2 class="mb-6 flex items-center gap-3 font-display text-2xl text-cloud">
              <span class="h-8 w-2 rounded-full bg-pale-iris" />
              Equipos y Maquinaria
            </h2>
            <div class="flex flex-wrap gap-3">
              {servicio.equipos.map((equipo) => (
                <span class="rounded-full border border-white/15 bg-white/10 px-4 py-2 text-sm text-ash">
                  {equipo}
                </span>
              ))}
            </div>
          </div>
        )
      }

      <div class="page-reveal rounded-lg border border-white/10 bg-white/5 p-8 text-center">
        <h3 class="mb-4 font-display text-2xl text-cloud">
          ¿Necesitas este servicio para tu proyecto?
        </h3>
        <p class="mx-auto mb-6 max-w-2xl text-ash">
          Contáctanos para una evaluación gratuita. Nuestro equipo de expertos está listo para
          ayudarte.
        </p>
        <div class="flex flex-col justify-center gap-4 sm:flex-row">
          <a
            href="/cotizacion"
            class="inline-flex items-center justify-center gap-2 rounded-lg bg-pure px-8 py-3 font-sans text-void"
          >
            Solicitar Cotización
          </a>
          <a
            href="/contacto"
            class="inline-flex items-center justify-center gap-2 rounded-lg border border-white/30 px-8 py-3 font-sans text-pure hover:bg-white/10"
          >
            Contactar
          </a>
        </div>
      </div>

      <div class="mt-12 flex items-center justify-between">
        <a
          href="/servicios"
          class="inline-flex items-center gap-2 rounded-lg border border-white/15 bg-white/5 px-6 py-3 text-pure hover:bg-white/10"
        >
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          Todos los Servicios
        </a>
        <a href="/#servicios" class="inline-flex items-center gap-2 text-ash hover:text-pure">
          Volver al Inicio
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
            />
          </svg>
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { revealOnScroll } from '@/lib/motion'
  revealOnScroll('.page-reveal', { start: 'top 95%' })
</script>
