---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/shared/PageHero.astro';
import ProjectCard from '@/components/projects/ProjectCard.astro';
import ProjectsCta from '@/components/projects/ProjectsCta.astro';
import Lightbox from '@/components/projects/Lightbox.astro';
import { portfolio } from '@/data/projects';
const breadcrumbs = [{ label: 'Inicio', href: '/' }, { label: 'Proyectos' }];
---

<BaseLayout
  title="Proyectos"
  description="Proyectos de Tenax Construction: movimiento de tierra, naves industriales, puentes, pavimentos, estructuras metálicas y seguridad perimetral en República Dominicana."
  breadcrumbs={breadcrumbs}
>
  <PageHero
    breadcrumbs={breadcrumbs}
    eyebrow="Proyectos"
    title="Nuestros"
    titleEmphasis="Proyectos"
    subtitle="Explora nuestros proyectos de movimiento de tierra, naves industriales, puentes y alcantarillados, pavimentos y estructuras metálicas."
    strip={['Industria', 'Comercio', 'Infraestructura']}
  />

  <section class="bg-surface-alt px-5 pt-[50px] pb-10">
    <div class="mx-auto max-w-[1100px]">
      <h2 data-reveal class="mb-6 text-[1.7rem] leading-[1.3]">Proyectos realizados</h2>
      <div data-reveal-children class="grid grid-cols-[repeat(auto-fill,minmax(340px,1fr))] gap-7 max-[900px]:grid-cols-1">
        {portfolio.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <ProjectsCta title="¿Tienes un proyecto en mente?" text="Contáctanos para una cotización personalizada." buttonLabel="Solicitar cotización" />

  <Lightbox />
</BaseLayout>
