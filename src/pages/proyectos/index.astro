---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/shared/PageHero.astro';
import ProjectTile from '@/components/projects/ProjectTile.astro';
import ProjectsCta from '@/components/projects/ProjectsCta.astro';
import { categories, projectsIn } from '@/data/portfolio';
const breadcrumbs = [{ label: 'Inicio', href: '/' }, { label: 'Proyectos' }];
// Cada categoría se presenta con la portada de su primer proyecto.
const tiles = categories.map((c) => ({ category: c, projects: projectsIn(c.id) })).filter((t) => t.projects.length > 0);
---

<BaseLayout
  title="Proyectos de construcción en RD"
  description="Proyectos de Tenax Construction en República Dominicana por categoría: industrial, comercial, energía, logística, agroindustrial, residencial, institucional y puentes."
  breadcrumbs={breadcrumbs}
>
  <PageHero
    breadcrumbs={breadcrumbs}
    eyebrow="Proyectos"
    title="Nuestros"
    titleEmphasis="Proyectos"
    subtitle="Obras industriales, comerciales, energéticas y de infraestructura ejecutadas por Tenax Construction en la República Dominicana, organizadas por categoría."
    strip={['Industria', 'Comercio', 'Energía', 'Infraestructura']}
  />

  <section class="bg-surface px-[20px] pt-[56px] pb-[64px]">
    <div class="mx-auto max-w-[1200px]">
      <div data-reveal class="mb-[32px] border-l-2 border-brand pl-[20px]">
        <h2 class="text-[1.7rem] leading-[1.3]">Proyectos por categoría</h2>
        <p class="mt-[8px] max-w-[720px] text-[1.05rem] text-body">Elige una categoría para ver sus proyectos y la ficha técnica de cada obra.</p>
      </div>
      <div data-reveal-children class="grid gap-[6px] sm:grid-cols-2 lg:grid-cols-3">
        {
          tiles.map(({ category, projects }) => (
            <ProjectTile
              href={category.href}
              image={projects[0].cover}
              caption={category.title}
              meta={projects.length === 1 ? '1 proyecto' : `${projects.length} proyectos`}
            />
          ))
        }
      </div>
    </div>
  </section>

  <ProjectsCta title="¿Tienes un proyecto en mente?" text="Contáctanos para una cotización personalizada." buttonLabel="Solicitar cotización" />
</BaseLayout>
