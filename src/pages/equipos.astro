---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/shared/PageHero.astro';
import MachinerySection from '@/components/equipment/MachinerySection.astro';
import EquipmentByService from '@/components/equipment/EquipmentByService.astro';
import { equipmentPage } from '@/data/equipment';

const { seo, hero, machinery, byService } = equipmentPage;
---

<BaseLayout title={seo.title} description={seo.description} breadcrumbs={hero.breadcrumbs}>
  <PageHero {...hero} />
  <MachinerySection data={machinery} />
  <EquipmentByService data={byService} />
</BaseLayout>
