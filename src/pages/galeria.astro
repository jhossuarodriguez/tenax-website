---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/shared/PageHero.astro';
import GalleryGrid from '@/components/gallery/GalleryGrid.astro';
import GalleryBand from '@/components/gallery/GalleryBand.astro';
import { galleryPage } from '@/data/gallery';

const { seo, hero, photos, band } = galleryPage;
---

<BaseLayout title={seo.title} description={seo.description} breadcrumbs={hero.breadcrumbs}>
  <PageHero {...hero} />
  <div class="text-ink">
    <GalleryGrid photos={photos} />
    <GalleryBand data={band} />
  </div>
</BaseLayout>
