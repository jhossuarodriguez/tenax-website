---
import type { GetStaticPaths } from 'astro'

import Layout from '../../layouts/Layout.astro'
import { PROJECTS_IMAGES } from '../../components/consts/Images'

const { id } = Astro.params
if (!id) return Astro.redirect('/404')

const project = PROJECTS_IMAGES.find((project) => project.id === id)
if (!project) return Astro.redirect('/404')

export const getStaticPaths = (() => {
  return PROJECTS_IMAGES.map((project) => ({
    params: { id: project.id },
  }))
}) satisfies GetStaticPaths

export const prerender = true
const canonical = `https://tenaxconstruction.com.do/projects/${id}`
---

<Layout canonical={canonical}>
  <section
    class="relative mx-auto flex w-full min-h-screen flex-col items-center justify-center bg-[url('/about-bg.webp')] bg-cover bg-center bg-no-repeat md:flex-row"
  >
    <div class="absolute inset-0 z-0 bg-obsidian/85"></div>
    <div
      class="page-reveal relative z-10 mx-0 mt-0 flex flex-col items-center justify-center md:mx-10 md:mt-20 md:flex-row"
    >
      <img
        data-id={id}
        src={`/projects/${id}.webp`}
        alt={project?.alt}
        class="w-[400px] rounded-lg object-cover md:w-[550px]"
        loading="lazy"
      />
      <div class="flex flex-col items-center justify-center">
        <div
          class="mx-10 mt-10 flex h-full w-[400px] flex-col items-start justify-center rounded-lg border border-white/10 bg-graphite/50 p-10 backdrop-blur-md md:w-[700px]"
        >
          <span class="font-mono text-xs uppercase tracking-[0.18em] text-ash">{project?.location}</span>
          <h1 class="mt-3 font-display text-2xl leading-[0.95] text-cloud md:text-3xl">
            {project?.title}
          </h1>
          <p class="mt-5 text-sm leading-relaxed text-ash md:text-lg">
            {project?.description || 'Descripción no disponible para este proyecto.'}
          </p>
        </div>
        <a
          href="/#proyectos"
          class="mt-14 inline-flex items-center gap-2 rounded-lg border border-white/30 px-6 py-3 font-sans text-sm text-pure hover:bg-white/10"
        >
          ← Atrás</a
        >
      </div>
    </div>
  </section>
</Layout>

<script>
  import { revealOnScroll } from '@/lib/motion'
  revealOnScroll('.page-reveal', { start: 'top 95%' })
</script>
