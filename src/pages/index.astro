---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { home } from '@/data/home';
import HomeHero from '@/components/home/HomeHero.astro';
import HomeVision from '@/components/home/HomeVision.astro';
import FeatureBand from '@/components/home/FeatureBand.astro';
import HomeSpecialties from '@/components/home/HomeSpecialties.astro';
import HomeShowcase from '@/components/home/HomeShowcase.astro';
import ContactSection from '@/components/home/ContactSection.astro';
import CtaBand from '@/components/home/CtaBand.astro';
---

<BaseLayout title={home.seo.title} description={home.seo.description}>
  <HomeHero hero={home.hero} />
  <HomeVision data={home.vision} />

  <!-- Movimientos de tierra -->
  <FeatureBand data={home.earthworks} />

  <!-- Diseño de Tenax en Canva (págs. 8-12): especialidades, proyectos destacados y barra naranja antes del contacto. -->
  <HomeSpecialties data={home.specialties} />
  <HomeShowcase data={home.showcase} />
  <div class="h-[24px] bg-brand" aria-hidden="true"></div>

  <ContactSection data={home.contact} />
  <CtaBand data={home.ctaBand} />
</BaseLayout>
