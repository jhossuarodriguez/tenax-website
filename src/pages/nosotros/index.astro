---
import Layout from '@/layouts/Layout.astro'
export const prerender = false

const seo = {
  canonical: 'https://www.tenaxconstruction.com.do/nosotros',
  title: 'Nosotros - Tenax Construction',
  description: 'Conoce más sobre Tenax Construction, nuestra historia y nuestros valores.',
}
---

<Layout {...seo}>
  <section
    class="relative w-full min-h-screen py-32 md:py-52 bg-[url('/about-bg.webp')] bg-cover bg-center bg-no-repeat"
  >
    <div class="absolute inset-0 z-0 bg-obsidian/80"></div>
    <div class="relative z-10 flex flex-col items-center justify-center px-6">
      <div class="page-reveal text-center">
        <span class="font-mono text-xs uppercase tracking-[0.18em] text-ash">Desde 2012</span>
        <h1 class="mt-4 font-display text-3xl leading-[0.95] text-cloud md:text-[38px]">
          Nuestra Historia
        </h1>
      </div>

      <div
        class="page-reveal mt-10 w-full max-w-3xl rounded-lg border border-white/10 bg-graphite/50 p-8 backdrop-blur-md md:p-10"
      >
        <p class="text-sm leading-relaxed text-ash md:text-lg">
          Somos una constructora dominicana dedicada a la administración, construcción, diseño, y
          supervisión de obras civiles, además de realizar estudios de viabilidad
          socio-económico y ambiental para respaldar cada proyecto.
          <br />
          <br />Fundada en el año 2012. Nuestra experiencia nos permite el manejo de proyectos
          altamente detallados, garantizando una óptima supervisión, para brindar excelentes
          resultados.
        </p>
      </div>

      <div class="page-reveal mt-14 flex flex-col items-center">
        <img
          src={`/logo-tenax.webp`}
          alt="Logo de Tenax Construction SRL"
          class="w-[220px] object-cover md:w-[320px]"
          loading="lazy"
        />

        <a
          href="/#nosotros"
          class="mt-10 inline-flex items-center gap-2 rounded-lg border border-white/30 px-6 py-3 font-sans text-sm text-pure hover:bg-white/10"
        >
          ← Atrás
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { revealOnScroll } from '@/lib/motion'
  revealOnScroll('.page-reveal', { start: 'top 95%' })
</script>
