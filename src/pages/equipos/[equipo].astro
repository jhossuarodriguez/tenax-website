---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/shared/Breadcrumbs.astro';
import ProjectTile from '@/components/projects/ProjectTile.astro';
import { equipmentPage } from '@/data/equipment';
import type { Machine } from '@/types';

const { machines } = equipmentPage.machinery;

export const getStaticPaths = (() =>
  equipmentPage.machinery.machines.map((machine) => ({ params: { equipo: machine.slug }, props: { machine } }))) satisfies GetStaticPaths;

interface Props {
  machine: Machine;
}

const RELATED_LIMIT = 3;
const DEFAULT_HEADERS = ['Característica', 'Especificación'];

const { machine } = Astro.props;
const { sheet, image } = machine;
const name = `${machine.type} ${machine.model}`;
const facts = [
  { label: 'Categoría', value: sheet.category },
  ...(sheet.facts.brand ? [{ label: 'Marca', value: sheet.facts.brand }] : []),
  ...(sheet.facts.year ? [{ label: 'Año', value: sheet.facts.year }] : []),
];
// Relacionados: primero los de la misma categoría de filtro; si no alcanzan, se completan con el resto.
const others = machines.filter((m) => m.slug !== machine.slug);
const related = [...others.filter((m) => m.category === machine.category), ...others.filter((m) => m.category !== machine.category)].slice(
  0,
  RELATED_LIMIT,
);
const breadcrumbs = [{ label: 'Inicio', href: '/' }, { label: 'Equipos', href: '/equipos/' }, { label: name }];
const description = `Ficha técnica de ${name} (${sheet.category.toLowerCase()}): características, especificaciones de referencia y aplicaciones en obra.`;
---

<BaseLayout title={`${name}: ficha técnica`} description={description} breadcrumbs={breadcrumbs}>
  <!--
    Ficha técnica de una máquina (Canva, págs. 32–37), con el diseño de la página de un proyecto: portada grafito con
    el nombre y la foto con corte diagonal y franja naranja; debajo, los datos clave a la izquierda y las tablas y las
    aplicaciones en obra a la derecha; al final, otros equipos.
  -->
  <section class="bg-white">
    <div class="relative grid bg-ink md:min-h-[440px] md:grid-cols-[minmax(0,38%)_1fr]">
      <div data-reveal-children class="relative z-10 flex flex-col justify-end px-[24px] py-[36px] md:py-[48px] md:pr-[12px] md:pl-[max(24px,calc((100vw-1200px)/2))]">
        <p class="font-mono text-[0.74rem] tracking-[0.05em] text-stone-2 uppercase">Ficha técnica · Equipos</p>
        <h1 class="mt-[10px] font-display text-[clamp(1.6rem,3.2vw,2.5rem)] leading-[1.15] font-semibold text-white">{name}</h1>
        <p class="mt-[12px] text-[1.05rem] leading-[1.5] text-sand">{sheet.category}</p>
      </div>
      <div class="relative min-h-[260px] md:[clip-path:polygon(70px_0,100%_0,100%_100%,0_100%)]">
        <img
          src={image.fullSrc ?? image.src}
          srcset={image.srcset}
          sizes="(min-width: 768px) 62vw, 100vw"
          alt={image.alt}
          fetchpriority="high"
          decoding="async"
          class="absolute inset-0 size-full object-cover"
        />
        <span
          class="absolute top-0 right-0 hidden h-[62%] w-[14px] bg-[repeating-linear-gradient(135deg,var(--color-brand)_0_6px,transparent_6px_12px)] md:block"
          aria-hidden="true"></span>
      </div>
    </div>
  </section>

  <section class="bg-white px-[20px] pt-[24px] pb-[64px]">
    <div class="mx-auto max-w-[1200px]">
      <Breadcrumbs items={breadcrumbs} class="mb-[40px]" />

      <div class="grid gap-[40px] md:grid-cols-[240px_1fr] lg:gap-[64px]">
        <aside data-reveal>
          <dl class="border-l-2 border-brand pl-[20px]">
            {
              facts.map((f) => (
                <div class="mb-[18px] last:mb-0">
                  <dt class="font-mono text-[0.7rem] tracking-[0.05em] text-stone uppercase">{f.label}</dt>
                  <dd class="mt-[2px] text-[0.98rem] leading-[1.4] text-ink">{f.value}</dd>
                </div>
              ))
            }
          </dl>
          <a href="/equipos/" class="mt-[28px] inline-flex items-center gap-[8px] pl-[22px] font-display text-[0.9rem] tracking-[0.04em] text-brand-dark uppercase hover:text-brand">
            <span aria-hidden="true">←</span> Todos los equipos
          </a>
        </aside>

        <div class="max-w-[760px] min-w-0">
          {sheet.intro && <p data-reveal class="mb-[32px] text-[1.02rem] leading-[1.7] text-body">{sheet.intro}</p>}

          {
            sheet.tables.map((table) => {
              const headers = table.headers ?? DEFAULT_HEADERS;
              const wide = headers.length > 2;
              return (
                <div data-reveal class="mb-[40px]">
                  <h2 class="mb-[8px] text-[clamp(1.2rem,2.2vw,1.45rem)] leading-[1.35] font-semibold text-brand-dark">{table.title}</h2>
                  {table.note && <p class="mb-[8px] text-[0.98rem] leading-[1.6] text-body">{table.note}</p>}
                  <div class="overflow-x-auto">
                    <table class:list={['w-full border-collapse text-left', wide && 'min-w-[520px]']}>
                      <thead>
                        <tr class="border-b-2 border-ink">
                          {headers.map((h, i) => (
                            <th scope="col" class:list={['py-[10px] pr-[16px] font-mono text-[0.7rem] font-semibold tracking-[0.05em] text-stone uppercase', wide && i > 0 && 'text-right']}>
                              {h}
                            </th>
                          ))}
                        </tr>
                      </thead>
                      <tbody>
                        {table.rows.map((row) => (
                          <tr class="border-b border-cream-2">
                            {row.map((cell, i) =>
                              i === 0 ? (
                                <th scope="row" class="py-[11px] pr-[16px] align-top text-[0.95rem] leading-[1.45] font-normal text-body">
                                  {cell}
                                </th>
                              ) : (
                                <td class:list={['py-[11px] pr-[16px] align-top text-[0.95rem] leading-[1.45] text-ink', wide && 'text-right']}>{cell}</td>
                              ),
                            )}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                  {table.footnote && <p class="mt-[10px] text-[0.85rem] leading-[1.5] text-stone">{table.footnote}</p>}
                </div>
              );
            })
          }

          {
            sheet.applications.length > 0 && (
              <div data-reveal>
                <h2 class="mb-[14px] text-[clamp(1.2rem,2.2vw,1.45rem)] leading-[1.35] font-semibold text-brand-dark">Aplicaciones en obra</h2>
                <ul class="grid gap-[8px]">
                  {sheet.applications.map((a) => (
                    <li class="flex gap-[12px] text-[1.02rem] leading-[1.55] text-body">
                      <span class="text-brand" aria-hidden="true">→</span>
                      {a}
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface px-[20px] pt-[48px] pb-[64px]">
    <div class="mx-auto max-w-[1200px]">
      <div data-reveal class="mb-[24px] border-l-2 border-brand pl-[20px]">
        <h2 class="text-[1.6rem] leading-[1.3]">Otros equipos</h2>
        <p class="mt-[4px] text-stone">Conoce el resto de la maquinaria de Tenax Construction.</p>
      </div>
      <div data-reveal-children class="grid gap-[6px] sm:grid-cols-2 lg:grid-cols-3">
        {related.map((m) => <ProjectTile href={m.href} image={m.image} caption={`${m.type} ${m.model}`} meta={m.sheet.category} />)}
      </div>
    </div>
  </section>
</BaseLayout>
