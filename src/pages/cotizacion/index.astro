---
import Layout from '@/layouts/Layout.astro'
import WhatsApp from '@/assets/icons/social/whatsapp.svg'
import Email from '@/assets/icons/social/email.svg'
import Calendar from '@/assets/icons/calendar.svg'
export const prerender = false
const seo = {
  canonical: 'https://www.tenaxconstruction.com.do/cotizacion',
  title: 'Cotización - Tenax Construction',
  description: 'Solicita una cotización para tu proyecto de construcción.',
}

const errors = { message: '' }
let success = false

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData()
    const nombre = data.get('nombre')?.toString()
    const email = data.get('email')?.toString()
    const telefono = data.get('telefono')?.toString()
    const presupuesto = data.get('presupuesto')?.toString()
    const tipoProyecto = data.get('tipoProyecto')?.toString()
    const descripcion = data.get('descripcion')?.toString()

    if (!nombre || !email || !telefono || !presupuesto || !tipoProyecto || !descripcion) {
      errors.message = 'Todos los campos marcados con * son obligatorios.'
    } else {
      // Redirigir al API endpoint
      const response = await fetch(new URL('/api/cotizacion', Astro.url), {
        method: 'POST',
        body: data,
      })

      if (response.ok) {
        success = true
      } else {
        errors.message = 'Error al enviar la cotización. Intenta nuevamente.'
      }
    }
  } catch (error) {
    console.error('Error:', error)
    errors.message = 'Error interno del servidor.'
  }
}

const inputClass =
  'w-full px-3 py-2.5 rounded-lg bg-white border border-white/10 text-cloud placeholder:text-fog focus:outline-none focus:ring-1 focus:ring-white/30'
const labelClass = 'block text-sm text-ash mb-2'
---

<Layout {...seo}>
  <section
    class="relative w-full min-h-screen py-32 bg-[url('/about-bg.webp')] bg-cover bg-center bg-no-repeat"
  >
    <div class="absolute inset-0 z-0 bg-obsidian/85"></div>
    <div class="relative z-10 mx-auto mt-20 max-w-4xl px-4">
      <header class="page-reveal mb-12 text-center">
        <span class="font-mono text-xs uppercase tracking-[0.18em] text-ash">Cuéntanos tu proyecto</span>
        <h1 class="mt-4 font-display text-3xl leading-[0.95] text-cloud md:text-[38px]">
          Solicita tu cotización
        </h1>
        <p class="mt-6 text-lg text-ash">
          Completa el formulario y te contactaremos en las próximas 24 horas
        </p>
      </header>

      <div class="page-reveal rounded-lg border border-white/10 bg-graphite/50 p-8 backdrop-blur-md">
        {
          success && (
            <div class="mb-6 rounded-lg border border-periwinkle/30 bg-periwinkle/10 p-4 text-periwinkle">
              ¡Cotización enviada exitosamente! Te contactaremos en las próximas 24 horas. Revisa tu
              email para la confirmación.
            </div>
          )
        }
        {
          errors.message && (
            <div class="mb-6 rounded-lg border border-orchid-bloom/30 bg-orchid-bloom/10 p-4 text-orchid-bloom">
              {errors.message}
            </div>
          )
        }

        <!-- Mensajes de estado del JavaScript -->
        <div id="message" class="hidden mb-6 p-4 rounded-lg">
          <div id="messageContent"></div>
        </div>

        <form id="cotizacionForm" class="space-y-6" method="POST">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="nombre" class={labelClass}> Nombre Completo * </label>
              <input
                type="text"
                id="nombre"
                name="nombre"
                required
                class={inputClass}
                placeholder="Nombre completo"
              />
            </div>

            <div>
              <label for="email" class={labelClass}> Email * </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class={inputClass}
                placeholder="Ingresa tu correo electrónico"
              />
            </div>

            <div>
              <label for="telefono" class={labelClass}> Teléfono * </label>
              <input
                type="tel"
                id="telefono"
                name="telefono"
                required
                class={inputClass}
                placeholder="+1 (809) 000-0000"
              />
            </div>

            <div>
              <label for="ubicacion" class={labelClass}> Ubicación del Proyecto </label>
              <input
                type="text"
                id="ubicacion"
                name="ubicacion"
                class={inputClass}
                placeholder="Ciudad, Sector"
              />
            </div>
          </div>

          <div>
            <label for="tipoProyecto" class={labelClass}> Tipo de Proyecto * </label>
            <select id="tipoProyecto" name="tipoProyecto" required class={inputClass}>
              <option value="">Selecciona el tipo de proyecto</option>
              <option value="residencial">Casa Residencial</option>
              <option value="edificio">Edificio/Apartamentos</option>
              <option value="comercial">Proyecto Comercial</option>
              <option value="industrial">Nave Industrial</option>
              <option value="remodelacion">Remodelación</option>
              <option value="otro">Otro</option>
            </select>
          </div>

          <div>
            <label for="presupuesto" class={labelClass}> Presupuesto Estimado </label>
            <select id="presupuesto" name="presupuesto" class={inputClass}>
              <option value="">Selecciona un rango</option>
              <option value="50k-100k">$50,000 - $100,000</option>
              <option value="100k-250k">$100,000 - $250,000</option>
              <option value="250k-500k">$250,000 - $500,000</option>
              <option value="500k-1m">$500,000 - $1,000,000</option>
              <option value="1m+">Más de $1,000,000</option>
            </select>
          </div>

          <div>
            <label for="descripcion" class={labelClass}> Descripción del Proyecto * </label>
            <textarea
              id="descripcion"
              name="descripcion"
              rows="4"
              required
              class={inputClass}
              placeholder="Describe tu proyecto: tipo de construcción, tamaño aproximado, características especiales, etc."
            ></textarea>
          </div>

          <div>
            <label for="fechaInicio" class={labelClass}> Fecha Deseada de Inicio </label>
            <input type="date" id="fechaInicio" name="fechaInicio" class={inputClass} />
          </div>

          <!-- Términos y condiciones -->
          <div class="flex items-start">
            <input
              type="checkbox"
              id="terminos"
              name="terminos"
              required
              class="mt-1 h-4 w-4 rounded border-white/30 bg-void text-pure focus:ring-white/30"
            />
            <label for="terminos" class="ml-2 text-sm text-ash">
              Acepto los <a href="#" class="text-pure hover:underline">términos y condiciones</a>
              y autorizo el procesamiento de mis datos personales para fines de cotización. *
            </label>
          </div>

          <!-- Botón de envío -->
          <div class="text-center">
            <button
              type="submit"
              id="submitBtn"
              class="rounded-lg bg-pure px-8 py-3 font-sans text-lg text-void disabled:cursor-not-allowed disabled:opacity-50 cursor-pointer"
            >
              <span id="submitText">Enviar Solicitud de Cotización</span>
              <span id="loadingText" class="hidden">Enviando...</span>
            </button>
          </div>
        </form>
      </div>

      <div class="contact-grid mt-12 grid grid-cols-1 gap-6 text-center md:grid-cols-3">
        <div class="contact-item flex flex-col items-center justify-center rounded-lg border border-white/10 bg-graphite/50 p-6">
          <h3 class="mb-2 text-lg font-semibold text-cloud">Llámanos</h3>
          <p class="text-ash">+1 (809) 898-6028</p>
          <a
            class="mt-2"
            href="https://wa.me/18098986028"
            target="_blank"
            rel="noopener noreferrer"
            title="Contáctanos por WhatsApp"
            aria-label="Contáctanos por WhatsApp"
          >
            <WhatsApp class="size-10 text-ash" />
          </a>
        </div>
        <div class="contact-item flex flex-col items-center justify-center rounded-lg border border-white/10 bg-graphite/50 p-6">
          <h3 class="mb-2 text-lg font-semibold text-cloud">Email</h3>
          <p class="text-ash">proyectos@tenax.com.do</p>
          <a
            class="mt-2"
            href="mailto:proyectos@tenax.com.do"
            title="Envíanos un correo electrónico"
            aria-label="Envíanos un correo electrónico"
          >
            <Email class="size-12 text-ash" />
          </a>
        </div>
        <div class="contact-item flex flex-col items-center justify-center rounded-lg border border-white/10 bg-graphite/50 p-6">
          <h3 class="mb-2 text-lg font-semibold text-cloud">Horario</h3>
          <p class="text-ash">Lun - Vie: 8:00 AM - 5:00 PM</p>
          <Calendar class="mt-2 size-10 text-ash" />
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const form = document.getElementById('cotizacionForm') as HTMLFormElement

    const messageDiv = document.getElementById('message') as HTMLDivElement
    const messageContent = document.getElementById('messageContent') as HTMLDivElement

    const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement

    const submitText = document.getElementById('submitText') as HTMLSpanElement

    const loadingText = document.getElementById('loadingText') as HTMLSpanElement

    // Ocultar mensajes del servidor si JavaScript está disponible
    const serverMessages = document.querySelectorAll('.mb-6.rounded-lg.border:not(#message)')
    serverMessages.forEach((msg) => {
      if (msg !== messageDiv) {
        ;(msg as HTMLElement).style.display = 'none'
      }
    })

    function showMessage(message: string, type: 'success' | 'error') {
      messageDiv.className = `mb-6 p-4 rounded-lg border ${
        type === 'success'
          ? 'border-periwinkle/30 bg-periwinkle/10 text-periwinkle'
          : 'border-orchid-bloom/30 bg-orchid-bloom/10 text-orchid-bloom'
      }`
      messageContent.innerHTML = message
      messageDiv.classList.remove('hidden')

      // Scroll hacia el mensaje
      messageDiv.scrollIntoView({ behavior: 'smooth', block: 'nearest' })
    }

    function hideMessage() {
      messageDiv.classList.add('hidden')
    }

    function setLoading(loading: boolean) {
      submitBtn.disabled = loading
      if (loading) {
        submitText.classList.add('hidden')
        loadingText.classList.remove('hidden')
      } else {
        submitText.classList.remove('hidden')
        loadingText.classList.add('hidden')
      }
    }

    form.addEventListener('submit', async function (e) {
      e.preventDefault()
      hideMessage()
      setLoading(true)

      const formData = new FormData(form)

      const response = await fetch('/api/cotizacion', {
        method: 'POST',
        body: formData,
      })

      const result = await response.json()

      if (response.ok && result.success) {
        showMessage(
          '¡Cotización enviada exitosamente! Te contactaremos en las próximas 24 horas. Revisa tu email para la confirmación.',
          'success'
        )
        form.reset()
      } else {
        showMessage(
          result.error || 'Hubo un error al enviar la cotización. Intenta nuevamente.',
          'error'
        )
      }

      setLoading(false)
    })
  })
</script>

<script>
  import { revealOnScroll, staggerOnScroll } from '@/lib/motion'
  revealOnScroll('.page-reveal', { start: 'top 95%' })
  staggerOnScroll('.contact-grid', '.contact-item')
</script>
