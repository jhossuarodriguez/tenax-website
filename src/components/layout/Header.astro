---
import { site } from '@/data/site';
import Icon from '@/components/ui/Icon.astro';
import SocialLinks from '@/components/layout/SocialLinks.astro';

const path = Astro.url.pathname;
const isActive = (href: string): boolean => (href === '/' ? path === '/' : path.startsWith(href));
/** Número de cada entrada del menú móvil ("01", "02"...), como en la estructura del sitio de Tenax. */
const navNumber = (i: number): string => String(i + 1).padStart(2, '0');
---

<!-- Header oscuro, como el de Tenax: su logo está pensado para fondo oscuro. -->
<header class="relative z-40 border-b border-white/10 bg-ink shadow-header">
  <!-- Escritorio. La columna del botón mide al menos su contenido para que no se parta en dos líneas. -->
  <div class="hidden min-h-[72px] grid-cols-[minmax(140px,1fr)_minmax(0,724px)_minmax(max-content,1fr)] items-center gap-[20px] px-[20px] tablet:grid">
    <a href="/" class="flex items-center justify-self-start" aria-label="Inicio">
      <picture>
        <source srcset={site.logo.avif} type="image/avif" />
        <img src={site.logo.src} alt={site.logo.alt} width={site.logo.width} height={site.logo.height} class="h-[52px] w-auto" />
      </picture>
    </a>

    <nav aria-label="Principal" class="justify-self-end">
      <ul class="flex items-center">
        {
          site.nav.map((item) => (
            <li class="group">
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'relative flex items-center gap-[4px] px-[8px] font-display text-[15px] leading-[72px] hover:text-brand lg:text-[16px] xl:px-[15px] xl:text-[17px]',
                  'after:absolute after:bottom-0 after:left-[0.6em] after:right-[0.6em] after:h-px after:origin-center after:scale-x-0 after:bg-current after:transition-transform hover:after:scale-x-100',
                  isActive(item.href) ? 'text-brand after:scale-x-100' : 'text-white/85',
                ]}
              >
                {item.label}
                {item.submenu && <Icon name="chevron-down" size={12} class="opacity-70 transition-transform group-hover:rotate-180" />}
              </a>
              {
                // Panel desplegable (como el menú de referencia): se abre al pasar el ratón o al llegar con el teclado.
                item.submenu && (
                  <div class="invisible absolute inset-x-0 top-full border-t border-white/10 bg-ink opacity-0 shadow-[0_18px_30px_rgba(0,0,0,0.25)] transition-[opacity,visibility] duration-200 group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100">
                    <!--
                      Los enlaces siguen alineados con el contenedor de 1200px; la columna de la foto suma el margen
                      derecho de la pantalla para llegar hasta la esquina sin dejar una franja vacía.
                    -->
                    <div class="grid grid-cols-[minmax(max-content,1fr)_minmax(240px,calc(380px_+_max(20px,_(100vw_-_1200px)_/_2_+_20px)))] gap-[40px] pl-[max(20px,calc((100vw_-_1200px)/2_+_20px))]">
                      <div class="py-[32px]">
                        <a href={item.href} class="flex items-center justify-between border-b border-white/15 pb-[14px] font-display text-[17px] tracking-[0.04em] text-brand uppercase hover:text-white">
                          {item.label}
                          <Icon name="arrow-right" size={16} />
                        </a>
                        <!--
                          Siempre 4 filas (las de Proyectos) y cada opción en una línea: así Nosotros, con 5 opciones,
                          mide lo mismo. En pantallas angostas cede la foto (mínimo 240px), no el texto.
                        -->
                        <ul class="mt-[20px] grid grid-cols-2 grid-rows-4 gap-x-[40px]">
                          {item.submenu.items.map((sub) => (
                            <li>
                              <a href={sub.href} class="flex items-baseline gap-[10px] py-[9px] whitespace-nowrap text-[15px] leading-[1.4] text-white/90 hover:text-brand">
                                <span class="text-brand" aria-hidden="true">↗</span>
                                {sub.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                      <div class="relative">
                        <img
                          src={item.submenu.image.src}
                          srcset={item.submenu.image.srcset}
                          sizes="calc(380px + max(20px, (100vw - 1200px) / 2 + 20px))"
                          alt=""
                          loading="lazy"
                          decoding="async"
                          class="absolute inset-0 size-full object-cover"
                        />
                        <!-- Degradado como el ejemplo de Tenax: oscurece la foto de abajo hacia arriba y la funde con el panel por la izquierda. -->
                        <div class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/40 to-ink/15" aria-hidden="true"></div>
                        <div class="absolute inset-0 bg-gradient-to-r from-ink via-ink/40 to-transparent" aria-hidden="true"></div>
                      </div>
                    </div>
                  </div>
                )
              }
            </li>
          ))
        }
      </ul>
    </nav>

    <a
      href={site.cta.href}
      class="justify-self-end rounded-[5px] bg-brand px-[20px] py-[12px] text-[14px] leading-[14px] font-medium text-white transition-colors hover:bg-brand-dark hover:text-white"
    >
      {site.cta.label}
    </a>
  </div>

  <!-- Móvil / tablet -->
  <div class="tablet:hidden" data-mobile-header>
    <div class="flex min-h-[64px] items-center justify-between px-[20px] py-[8px]">
      <a href="/" aria-label="Inicio">
        <picture>
          <source srcset={site.logo.avif} type="image/avif" />
          <img src={site.logo.src} alt={site.logo.alt} width={site.logo.width} height={site.logo.height} class="h-[44px] w-auto" />
        </picture>
      </a>
      <button
        type="button"
        class="group grid size-[42px] place-items-center rounded-[2px] bg-white/10 text-white"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú"
        data-menu-toggle
      >
        <Icon name="menu" size={20} class="group-aria-expanded:hidden" />
        <Icon name="close" size={20} class="hidden group-aria-expanded:block" />
      </button>
    </div>

    <div id="mobile-menu" class="hidden border-t border-white/10 bg-ink pb-[20px]" data-menu-panel>
      <nav aria-label="Principal móvil">
        <ul>
          {
            site.nav.map((item, i) => (
              <li class="border-b border-white/10">
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class:list={['flex items-baseline gap-[12px] px-[20px] py-[12px]', isActive(item.href) ? 'text-brand' : 'text-white/85 hover:text-brand']}
                >
                  <span class="font-mono text-[12px] text-brand" aria-hidden="true">{navNumber(i)}</span>
                  <span>
                    <span class="block font-display text-[17px] leading-[1.4]">{item.label}</span>
                    {item.description && <span class="block text-[13px] leading-[1.4] text-stone-2">{item.description}</span>}
                  </span>
                </a>
                {item.submenu && (
                  <ul class="-mt-[4px] pb-[10px] pl-[52px]">
                    {item.submenu.items.map((sub) => (
                      <li>
                        <a href={sub.href} class="flex items-baseline gap-[8px] py-[5px] text-[14px] leading-[1.4] text-white/75 hover:text-brand">
                          <span class="text-brand" aria-hidden="true">↗</span>
                          {sub.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="flex flex-col items-start gap-[16px] px-[20px] pt-[20px]">
        <a href={site.cta.href} class="rounded-[5px] bg-brand px-[20px] py-[12px] text-[14px] leading-[14px] font-medium text-white hover:bg-brand-dark hover:text-white">
          {site.cta.label}
        </a>
        <SocialLinks variant="header" />
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    panel?.classList.toggle('hidden', !open);
  });
</script>
