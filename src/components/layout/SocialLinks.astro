---
import { site } from '@/data/site';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<!-- Iconos blancos de las redes, para el menú móvil oscuro. -->
<ul class:list={['flex flex-wrap items-center gap-[16px] leading-none', className]}>
  {
    site.socials.map((s) => (
      <li>
        <a href={s.href} aria-label={s.label} class="inline-flex items-center text-white hover:text-brand">
          <Icon name={s.network} size={18} />
        </a>
      </li>
    ))
  }
</ul>
