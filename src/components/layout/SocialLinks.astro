---
import { site } from '@/data/site';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  /** header: solo iconos blancos (menú móvil oscuro). footer: icono y etiqueta en blanco. */
  variant: 'header' | 'footer';
  class?: string;
}

const { variant, class: className } = Astro.props;
---

<ul class:list={['flex flex-wrap items-center', variant === 'footer' ? 'justify-center gap-y-[10px] leading-[17px]' : 'gap-[16px] leading-none', className]}>
  {
    site.socials.map((s) => (
      <li>
        <a
          href={s.href}
          aria-label={s.label}
          class:list={[
            'inline-flex items-center',
            variant === 'footer' ? 'mx-[15px] px-[7px] text-[17px] text-white hover:opacity-80' : 'text-white hover:text-brand',
          ]}
        >
          <Icon name={s.network} size={18} />
          {variant === 'footer' && <span class="pl-[6px]">{s.label}</span>}
        </a>
      </li>
    ))
  }
</ul>
