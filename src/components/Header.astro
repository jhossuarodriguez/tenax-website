---
import { Image } from 'astro:assets'

const CENTER_LINKS = [
  { href: '/', label: 'Inicio' },
  { href: '/#nosotros', label: 'Nosotros' },
  { href: '/#proyectos', label: 'Proyectos' },
  { href: '/servicios', label: 'Servicios' },
]

const RIGHT_LINKS = [
  { href: '/contacto', label: 'Contacto' },
  { href: '/cotizacion', label: 'Cotizar' },
]

const ALL_LINKS = [...CENTER_LINKS, ...RIGHT_LINKS]
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 w-full border-b border-transparent py-4 transition-[background-color,backdrop-filter,border-color] duration-300"
>
  <div class="content-shell flex flex-row items-center justify-between gap-6">
    <a
      class="flex shrink-0 items-center"
      href="/"
      title="Ir a la página principal de Tenax Construction"
      aria-label="Ir a la página principal"
    >
      <Image
        class="w-36 sm:w-44 md:w-48 lg:w-56 h-auto aspect-786/317"
        width="240"
        height="180"
        src="/logo-tenax.webp"
        alt="Logo Tenax Construction"
        format="webp"
        fetchpriority="high"
        decoding="async"
        loading="eager"
      />
    </a>

    <nav class="hidden flex-1 items-center justify-center gap-8 lg:gap-10 md:flex">
      {
        CENTER_LINKS.map((link) => (
          <a
            href={link.href}
            class="nav-tab border-t-2 border-transparent px-4 py-3 font-display text-lg font-medium tracking-wide text-pure/90 transition-colors duration-200 hover:border-primary                hover:text-primary"
            title={`Ir a ${link.label}`}
            aria-label={`Ir a ${link.label}`}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-6 md:flex">
      <button
        id="mobile-menu-button"
        class="flex h-9 w-11 flex-col items-center justify-center gap-1.5 cursor-pointer border-none bg-transparent"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
      >
        <span class="hamburger-bar block h-px w-6 bg-pure"></span>
        <span class="hamburger-bar block h-px w-6 bg-pure"></span>
        <span class="hamburger-bar block h-px w-6 bg-pure"></span>
      </button>

      {
        RIGHT_LINKS.map((link) => (
          <a
            href={link.href}
            class="nav-link-right whitespace-nowrap font-display text-lg font-medium tracking-wide text-pure/90 hover:text-primary"
            title={`Ir a ${link.label}`}
            aria-label={`Ir a ${link.label}`}
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <button
      id="mobile-menu-button-sm"
      class="flex md:hidden h-10 w-10 flex-col items-center justify-center gap-1.5 cursor-pointer border-none bg-transparent"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
    >
      <span class="hamburger-bar block h-px w-6 bg-pure"></span>
      <span class="hamburger-bar block h-px w-6 bg-pure"></span>
      <span class="hamburger-bar block h-px w-6 bg-pure"></span>
    </button>
  </div>

  <nav
    id="mobile-menu"
    class="fixed inset-0 hidden h-dvh w-full flex-col items-center justify-center gap-6 bg-obsidian/98 pt-20 uppercase backdrop-blur-lg"
  >
    {
      ALL_LINKS.map((link) => (
        <a
          href={link.href}
          class="nav-link inline-flex items-center rounded-lg px-4 py-2.5 font-sans text-lg font-normal text-pure/85 hover:bg-white/10 hover:text-pure"
          title={`Ir a ${link.label}`}
          aria-label={`Ir a ${link.label}`}
        >
          {link.label}
        </a>
      ))
    }
  </nav>

  <button
    id="close-menu-button"
    class="fixed top-4 right-4 z-70 hidden h-8 w-8 cursor-pointer border-none bg-transparent text-2xl text-pure"
    aria-label="Cerrar menú de navegación"
  >
    ×
  </button>
</header>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const mobileMenuButtons = document.querySelectorAll('#mobile-menu-button, #mobile-menu-button-sm')
    const closeMenuButton = document.getElementById('close-menu-button')
    const mobileMenu = document.getElementById('mobile-menu')

    function toggleMenu() {
      const isOpen = mobileMenu?.classList.contains('flex')

      if (isOpen) {
        mobileMenu?.classList.remove('flex')
        mobileMenu?.classList.add('hidden')
        mobileMenuButtons.forEach((btn) => btn.setAttribute('aria-expanded', 'false'))
        document.body.style.overflow = ''
        if (closeMenuButton) closeMenuButton.style.display = 'none'
      } else {
        mobileMenu?.classList.remove('hidden')
        mobileMenu?.classList.add('flex')
        mobileMenuButtons.forEach((btn) => btn.setAttribute('aria-expanded', 'true'))
        document.body.style.overflow = 'hidden'
        if (closeMenuButton) closeMenuButton.style.display = 'block'
      }
    }

    mobileMenuButtons.forEach((btn) => btn.addEventListener('click', toggleMenu))
    closeMenuButton?.addEventListener('click', toggleMenu)

    const navLinks = mobileMenu?.querySelectorAll('a')
    navLinks?.forEach((link) => {
      link.addEventListener('click', toggleMenu)
    })
  })
</script>

<script>
  import { gsap, ScrollTrigger } from '@/lib/motion'

  const header = document.getElementById('site-header')
  if (header) {
    gsap.fromTo(
      header,
      { autoAlpha: 0, y: -16 },
      { autoAlpha: 1, y: 0, duration: 0.5, ease: 'power2.out' }
    )

    ScrollTrigger.create({
      start: 'top -80',
      onUpdate: (self) => {
        header.classList.toggle('is-scrolled', self.scroll() > 80)
      },
    })

  }
</script>

<style>
  #site-header.is-scrolled {
    background-color: var(--color-paper);
    border-bottom-color: rgba(0, 0, 0, 0.08);
  }

  #site-header.is-scrolled .nav-tab,
  #site-header.is-scrolled .nav-link-right {
    color: var(--color-ink);
  }

  #site-header.is-scrolled .hamburger-bar {
    background-color: var(--color-ink);
  }
</style>
