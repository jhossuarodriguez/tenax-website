---
import { Picture } from "astro:assets";
import { PROJECTS_IMAGES } from "@/components/consts/Images";

const FEATURED_PROJECT = PROJECTS_IMAGES.find(
  (project) => project.id === "Paneles-4",
)!;
const PORTFOLIO_FEATURED_PROJECT = PROJECTS_IMAGES[0];
const PORTFOLIO_PROJECTS = PROJECTS_IMAGES.slice(1);
---

<section class="w-full bg-paper">
  <div class="content-shell border-t border-black/10 py-20 md:py-28">
    <div class="projects-intro-reveal grid grid-cols-1 items-center gap-10 md:grid-cols-[880px_1fr] md:gap-16">
      <div class="overflow-hidden rounded-lg md:w-[880px]">
        <Picture
          src="/about-bg.webp"
          alt="Proyecto de construcción Tenax Construction"
          width={880}
          height={500}
          class="aspect-880/500 w-full object-cover"
          loading="lazy"
        />
      </div>
      <div>
        <span class="font-mono text-xs uppercase tracking-[0.18em] text-primary">
          {FEATURED_PROJECT.location}
        </span>
        <h2 class="mt-4 font-display text-4xl leading-[1] text-ink md:text-5xl lg:text-6xl">
          Nuestro trabajo en tu comunidad
        </h2>
        <p class="mt-6 max-w-md text-base leading-relaxed text-slate md:text-lg">
          Juntos podemos hacer crecer comunidades, fortalecer la economía y mejorar vidas en toda
          República Dominicana.
        </p>
      </div>
    </div>
  </div>

  <div class="border-t border-black/10">
    <div class="content-shell grid grid-cols-1 md:grid-cols-2">
      <a
        href="#projects-grid"
        class="group flex items-center justify-center gap-3 border-b border-black/10 px-6 py-6 font-mono text-xs uppercase tracking-[0.14em] text-slate transition-colors duration-200 hover:text-ink md:border-b-0 md:border-r"
      >
        Ver todos nuestros proyectos
        <span aria-hidden="true" class="text-orchid-bloom transition-transform duration-300 group-hover:translate-x-1">→</span>
      </a>
      <span class="flex items-center justify-center border-b border-black/10 px-6 py-6 text-sm text-slate">
        Explora cada proyecto realizado
      </span>
    </div>
  </div>

  <div class="content-shell py-20 md:py-28">
    <header class="projects-portfolio-reveal">
      <span class="font-mono text-xs uppercase tracking-[0.18em] text-slate">Portafolio</span>
      <h2 class="mt-4 max-w-4xl font-display text-4xl leading-[0.95] text-ink md:text-6xl lg:text-[72px]">
        Nuestros Proyectos
      </h2>
    </header>

    <div id="projects-grid" class="mt-8 grid w-full gap-10 lg:h-[760px] lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] lg:gap-0">
      <article class="project-card group flex flex-col lg:pr-12">
        <a href={`/projects/${PORTFOLIO_FEATURED_PROJECT.id}`} class="overflow-hidden rounded-lg bg-mist">
          <Picture
            src={`/projects/${PORTFOLIO_FEATURED_PROJECT.id}.webp`}
            alt={PORTFOLIO_FEATURED_PROJECT.alt}
            width={960}
            height={620}
            class="project-image aspect-[1.55] w-full object-cover transition-transform duration-700 group-hover:scale-[1.03] lg:h-[500px] lg:aspect-auto"
            loading="lazy"
          />
        </a>
        <div class="pt-7">
          <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-slate">Proyecto destacado</span>
          <a href={`/projects/${PORTFOLIO_FEATURED_PROJECT.id}`} class="block">
            <h3 class="mt-3 max-w-3xl font-display text-2xl leading-[0.98] text-ink md:text-4xl">
              {PORTFOLIO_FEATURED_PROJECT.title}
            </h3>
          </a>
          <a href={`/projects/${PORTFOLIO_FEATURED_PROJECT.id}`} class="inline-flex">
            <span class="mt-6 inline-flex items-center gap-3 font-mono text-xs uppercase tracking-[0.14em] text-slate transition-colors group-hover:text-ink">
              Ver proyecto <span aria-hidden="true" class="text-orchid-bloom">→</span>
            </span>
          </a>
        </div>
      </article>

      <div
        class="project-scroll-column hidden lg:block lg:overflow-y-auto lg:border-l lg:border-black/10"
        tabindex="0"
        aria-label="Lista de proyectos"
      >
        <div class="project-scroll-content grid grid-cols-1 gap-x-12 gap-y-10 lg:px-12 xl:grid-cols-2">
          {
            PORTFOLIO_PROJECTS.map((project) => (
              <article class="project-card group block">
                <a href={`/projects/${project.id}`} class="overflow-hidden rounded-lg bg-mist">
                  <Picture
                    src={`/projects/${project.id}.webp`}
                    alt={project.alt}
                    width={600}
                    height={360}
                    class="project-image aspect-[1.67] w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
                    loading="lazy"
                  />
                </a>
                <div class="pt-5">
                  <a href={`/projects/${project.id}`} class="block">
                    <h3 class="font-display text-xl leading-[0.98] text-ink md:text-2xl">{project.title}</h3>
                  </a>
                  <p class="mt-3 font-mono text-[10px] uppercase tracking-[0.14em] text-slate">{project.location}</p>
                  <a href={`/projects/${project.id}`} class="inline-flex">
                    <span class="mt-5 inline-flex items-center gap-3 font-mono text-xs uppercase tracking-[0.14em] text-slate transition-colors group-hover:text-ink">
                      Ver proyecto <span aria-hidden="true" class="text-orchid-bloom">→</span>
                    </span>
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>

    <div class="mt-14 flex flex-col items-center justify-center gap-y-5">
      <p class="text-base text-slate">Explora nuestros proyectos destacados</p>
      <a
        href="/cotizacion"
        class="inline-flex items-center gap-2 rounded-lg bg-primary px-6 py-3 font-sans text-base text-pure"
      >
        Solicitar cotización
      </a>
    </div>
  </div>
</section>

<script>
  import { revealOnScroll, staggerOnScroll } from "@/lib/motion";

  revealOnScroll(".projects-intro-reveal");
  revealOnScroll(".projects-portfolio-reveal");
  staggerOnScroll("#projects-grid", ".project-card", { stagger: 0.08 });
</script>
