---
import { Image } from 'astro:assets'
import { NEWS } from '@/components/consts/News'
---

<section class="w-full bg-paper py-24 md:py-32">
  <div class="flex flex-col items-center justify-center px-6">
    <span class="font-mono text-xs uppercase tracking-[0.18em] text-slate">Blog</span>
    <header class="mt-4 text-center font-display text-3xl leading-[0.95] text-ink md:text-[38px]">
      Últimas Novedades
    </header>
  </div>

  <div class="news-grid mx-auto mt-16 grid max-w-5xl grid-cols-1 gap-6 px-6 sm:grid-cols-2">
    {
      NEWS.map((news) => (
        <a href={`/news/${news.id}`} class="news-item group">
          <figure class="mx-auto flex h-full w-full max-w-[400px] flex-col overflow-hidden rounded-lg border border-black/10 bg-mist">
            <Image
              data-id={news.id}
              src={`/news/${news.id}.webp`}
              alt={news.title}
              width={400}
              height={225}
              class="h-auto w-full flex-shrink-0 object-cover"
              loading="lazy"
            />
            <figcaption class="flex flex-1 flex-col p-5">
              <header class="mb-2 flex-shrink-0 font-sans text-base font-medium text-ink">
                {news.title}
              </header>
              <p class="mb-3 line-clamp-3 flex-1 text-sm leading-relaxed text-slate">
                {news.description}
              </p>
              <div class="flex flex-shrink-0 items-center space-x-2 font-mono text-xs uppercase tracking-[0.1em] text-slate/70">
                <span>{new Date(news.date).toLocaleDateString()}</span>
                <span>•</span>
                <span>Por {news.author}</span>
              </div>
            </figcaption>
          </figure>
        </a>
      ))
    }
  </div>
</section>

<script>
  import { staggerOnScroll } from '@/lib/motion'
  staggerOnScroll('.news-grid', '.news-item')
</script>
