---
import type { HomeAboutData } from '@/types';
// Carrusel desactivado: para usarlo, descomenta este import y el bloque del carrusel de abajo.
// import Carousel from '@/components/home/Carousel.astro';

interface Props {
  data: HomeAboutData;
}

const { data } = Astro.props;
---

<div class="mx-auto max-w-[1200px] px-[20px] pt-[36px] pb-[48px] md:px-[24px] md:pt-[48px] md:pb-[72px]">
  <div data-reveal-children class="grid items-center gap-[32px] md:grid-cols-2 md:gap-[48px]">
    <img
      src={data.image.src}
      srcset={data.image.srcset}
      sizes="(min-width: 1200px) 552px, (min-width: 768px) calc((100vw - 96px) / 2), calc(100vw - 40px)"
      alt={data.image.alt}
      loading="lazy"
      decoding="async"
      class="block aspect-[5/4] w-full object-cover"
      style={data.image.position ? `object-position:${data.image.position}` : undefined}
    />

    {/*
      Carrusel de fotos (desactivado). Para usarlo en lugar de la imagen principal, descomenta este bloque
      y el import de Carousel, y quita la <img> de arriba.

      <Carousel label="Equipos y maquinarias" autoplay={4000}>
        {data.slides.map((s) => (
          <figure class="m-0 h-[525px] overflow-hidden">
            <img
              src={s.src}
              alt={s.alt}
              class="pointer-events-none block size-full object-cover"
              style={s.position ? `object-position:${s.position}` : undefined}
              loading="lazy"
              decoding="async"
            />
          </figure>
        ))}
      </Carousel>
    */}

    <div>
      <h3 class="text-[1.25rem] leading-[1.3] font-bold tracking-[0.02em] text-ink">{data.title}</h3>
      {data.paragraphs.map((p) => <p class="mt-[20px] text-[1.05rem] leading-[1.7] text-body">{p}</p>)}
    </div>
  </div>
</div>
