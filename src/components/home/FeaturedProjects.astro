---
import type { HomeProject } from '@/types';

interface Props {
  items: HomeProject[];
}

const { items } = Astro.props;
---

<ul data-reveal-children class="mx-auto grid max-w-[1200px] gap-[24px] px-[20px] sm:grid-cols-2 lg:grid-cols-3">
  {
    items.map((p) => (
      <li>
        <article class="flex h-full flex-col overflow-hidden rounded-[6px] bg-white shadow-[0_2px_12px_rgba(36,39,43,0.12)]">
          <img
            src={p.image.src}
            alt={p.image.alt}
            loading="lazy"
            decoding="async"
            class="block aspect-[16/10] w-full object-cover"
            style={p.image.position ? `object-position:${p.image.position}` : undefined}
          />
          <div class="flex flex-1 flex-col px-[24px] pt-[20px] pb-[26px]">
            <p class="text-[0.78rem] leading-[1.6rem] font-semibold tracking-[0.03em] text-brand-dark uppercase">{p.eyebrow}</p>
            <h3 class="mt-[6px] text-[1.25rem] leading-[1.3] text-ink">{p.title}</h3>
            <p class="mt-[8px] text-[0.95rem] leading-[1.55] text-body">{p.text}</p>
          </div>
        </article>
      </li>
    ))
  }
</ul>
