---
import type { HomeReason } from '@/types';

interface Props {
  items: HomeReason[];
}

const { items } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-ink px-[34px] py-[100.8px] text-white">
  <!-- Cuadrícula tenue con máscara radial (efecto "grid" del original). -->
  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-[linear-gradient(to_right,rgba(255,255,255,0.12)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.12)_1px,transparent_1px)] bg-size-[50px_50px] opacity-35 mask-[radial-gradient(ellipse_50%_50%_at_50%_20%,#000_70%,rgba(0,0,0,0.3)_100%)]"
  >
  </div>

  <ul data-reveal-children class="mx-auto grid max-w-[1200px] gap-[24px] md:grid-cols-2 md:gap-x-[17px] xl:grid-cols-4">
    {
      items.map((r) => (
        <li class="flex min-h-[300px] flex-col gap-[17px] rounded-[8.5px] border border-white/10 bg-card p-[42.5px]">
          <p class="font-sans text-[2.375rem] leading-[1.25] font-light tracking-[2px] text-brand">{r.number}</p>
          <h3 class="font-heading text-[1.125rem] leading-[1.6] font-semibold text-white">{r.title}</h3>
          <p class="text-base leading-[1.6] text-balance text-white/80">{r.text}</p>
        </li>
      ))
    }
  </ul>
</section>
