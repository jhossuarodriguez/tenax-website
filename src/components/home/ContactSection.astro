---
import { site } from '@/data/site';
import type { HomeContactData } from '@/types';
import Icon from '@/components/ui/Icon.astro';
import ContactForm from '@/components/home/ContactForm.astro';

interface Props {
  data: HomeContactData;
}

const { data } = Astro.props;
const { contact } = site;

const items: { icon: 'map-pin' | 'phone' | 'chat' | 'mail' | 'check'; text: string; href?: string }[] = [
  { icon: 'map-pin', text: contact.address, href: contact.mapsUrl },
  { icon: 'phone', text: contact.phone, href: `tel:${contact.phoneHref}` },
  { icon: 'chat', text: 'Escríbenos por WhatsApp', href: contact.whatsapp },
  { icon: 'mail', text: contact.email, href: `mailto:${contact.email}` },
  { icon: 'check', text: contact.hours },
];
---

<section>
  <div data-reveal-children class="px-[24px] py-[72px] text-center">
    <h2 class="mb-[16px] font-heading leading-[1.3] font-bold text-heading">{data.introTitle}</h2>
    <p class="mb-[27px] text-body">{data.introText}</p>
  </div>

  <!-- Banda con imagen fija (parallax) -->
  <div class="mt-[24px] min-h-[350px] bg-cover bg-fixed bg-center" style={`background-image:url(${data.bandImage})`} aria-hidden="true"></div>

  <div data-reveal-children class="mx-auto flex max-w-[1200px] flex-wrap items-start gap-[48px] px-[20px] pt-[64px] pb-[64px] md:px-[24px] md:pt-[88px]">
    <div class="min-w-0 flex-[1_1_420px]">
      <h2 class="mb-[20px] font-heading leading-[1.3] font-bold text-heading">{data.title}</h2>
      <p class="mb-[27px] text-body">{data.text}</p>
      <ul>
        {
          items.map((it) => (
            <li class="flex items-start gap-[12px]">
              <span class="inline-flex w-[24px] flex-none justify-center pt-0.5 text-heading">
                <Icon name={it.icon} size={20} />
              </span>
              {it.href ? (
                <a href={it.href} class="text-[15px] leading-[1.6] text-body hover:text-brand">
                  {it.text}
                </a>
              ) : (
                <span class="text-[15px] leading-[1.6] text-body">{it.text}</span>
              )}
            </li>
          ))
        }
      </ul>
      <iframe
        src={contact.mapEmbedUrl}
        title="Mapa de ubicación"
        class="mt-0 block h-[300px] w-full rounded-md border-0"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen></iframe>
    </div>

    <div class="min-w-0 flex-[1_1_420px] rounded-md bg-surface px-[32px] py-[40px] shadow-[0_4px_8px_-2px_rgba(0,0,0,0.1)]">
      <ContactForm />
    </div>
  </div>
</section>
