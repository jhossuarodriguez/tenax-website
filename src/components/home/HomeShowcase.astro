---
import type { HomeShowcaseData } from '@/types';
import BrandRule from '@/components/home/BrandRule.astro';
import { coverSrcset } from '@/data/obras';

interface Props {
  data: HomeShowcaseData;
}

const { data } = Astro.props;
---

<!--
  "Proyectos Destacados" (diseño de Tenax en Canva, pág. 11): banda grafito con texto y una foto grande que
  sobresale por arriba; debajo, tres proyectos con su pie, que enlazan a su ficha.
-->
<section class="relative bg-white lg:pt-[80px]">
  <BrandRule />
  <div class="bg-ink px-[20px] py-[56px] lg:pt-0 lg:pb-[72px]">
    <div class="mx-auto grid max-w-[980px] gap-[40px] lg:grid-cols-[360fr_568fr] lg:items-start lg:gap-[52px]">
      <div data-reveal-children class="lg:pt-[66px]">
        <h2 class="font-display text-[clamp(2.1rem,3.6vw,3.2rem)] leading-[1.1] font-semibold text-white">{data.title}</h2>
        {data.paragraphs.map((p) => <p class="mt-[24px] text-[clamp(1.05rem,1.4vw,1.25rem)] leading-[1.35] text-white">{p}</p>)}
      </div>
      <div data-reveal class="aspect-[250/258] overflow-hidden bg-dark lg:-mt-[80px]">
        <img
          src={data.image.src}
          srcset={coverSrcset(data.image, 250 / 258)}
          sizes="(min-width: 1020px) 568px, calc(100vw - 40px)"
          alt={data.image.alt}
          loading="lazy"
          decoding="async"
          class="size-full object-cover"
        />
      </div>
    </div>
  </div>

  <!--
    Mismo mosaico que las especialidades: fotos casi sin separación y el pie en una pestaña blanca de borde
    diagonal sobre la esquina inferior derecha. En tablet (2 columnas) la tercera ocupa toda la fila.
  -->
  <div class="px-[20px] pt-[64px] pb-[44px]">
    <ul data-reveal-children class="mx-auto grid max-w-[1180px] gap-[6px] sm:grid-cols-2 lg:grid-cols-3">
      {
        data.projects.map((project, i) => {
          const spansTablet = i === data.projects.length - 1 && data.projects.length % 2 === 1;
          return (
            <li class:list={[spansTablet && 'sm:col-span-2 lg:col-span-1']}>
              <a
                href={project.href}
                class:list={[
                  'group relative block aspect-[174/126] overflow-hidden bg-surface',
                  spansTablet && 'sm:aspect-[354/126] lg:aspect-[174/126]',
                ]}
              >
                <img
                  src={project.image.src}
                  srcset={coverSrcset(project.image, 174 / 126)}
                  sizes={
                    spansTablet
                      ? '(min-width: 1220px) 390px, (min-width: 1024px) calc((100vw - 52px) / 3), calc(100vw - 40px)'
                      : '(min-width: 1220px) 390px, (min-width: 1024px) calc((100vw - 52px) / 3), (min-width: 640px) calc((100vw - 46px) / 2), calc(100vw - 40px)'
                  }
                  alt={project.image.alt}
                  loading="lazy"
                  decoding="async"
                  class="size-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                  style={project.image.position ? `object-position:${project.image.position}` : undefined}
                />
                <p class="absolute right-0 bottom-0 max-w-[calc(100%-32px)] bg-white py-[10px] pr-[14px] pl-[36px] text-right text-[13px] leading-[1.3] text-ink [clip-path:polygon(24px_0,100%_0,100%_100%,0_100%)] group-hover:text-brand">
                  {project.caption}
                </p>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
