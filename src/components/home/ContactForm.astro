---
import { homeFormFields } from '@/data/home';

const input =
  'block w-full rounded-[7px] border border-[#dadbdd] bg-[#fafafa] px-[15px] py-[11px] font-sans text-[17px] leading-[19px] text-[#606266] placeholder:text-[#a8abb2] focus:border-body focus:outline-none';
---

<form class="grid grid-cols-1 gap-x-[15px] gap-y-[20px] md:grid-cols-2" method="post" action="#" novalidate data-home-form>
  {
    homeFormFields.map((f) => (
      <div class:list={[f.half ? 'md:col-span-1' : 'md:col-span-2']}>
        <label for={`hf-${f.name}`} class="mb-[6px] block text-[17px] leading-[27px] font-medium text-body">
          {f.label}
          {f.required && <span class="ml-[6px] text-brand" aria-hidden="true">*</span>}
        </label>
        {f.type === 'textarea' ? (
          <textarea id={`hf-${f.name}`} name={f.name} rows="6" placeholder={f.placeholder} required={f.required} class:list={[input, 'h-[126px] resize-y']} />
        ) : f.type === 'select' ? (
          <select id={`hf-${f.name}`} name={f.name} required={f.required} class={input}>
            <option value="" disabled selected>{f.placeholder}</option>
            {f.options?.map((o) => <option value={o}>{o}</option>)}
          </select>
        ) : (
          <input id={`hf-${f.name}`} name={f.name} type={f.type} placeholder={f.placeholder} required={f.required} class={input} />
        )}
      </div>
    ))
  }

  <div class="pb-[20px] md:col-span-2">
    <button
      type="submit"
      class="rounded-[7px] bg-brand px-[20px] py-[8px] text-[16px] leading-[24px] font-medium text-white transition-colors hover:bg-brand-dark"
    >
      Enviar
    </button>
    <p class="mt-[12px] hidden text-[15px] text-body" role="status" data-form-status></p>
  </div>
</form>

<script>
  // Formulario de demostración: valida en el cliente y muestra un aviso (sin backend).
  document.querySelectorAll<HTMLFormElement>('[data-home-form]').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const status = form.querySelector<HTMLElement>('[data-form-status]');
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      if (status) {
        status.textContent = 'Gracias, hemos recibido tu mensaje.';
        status.classList.remove('hidden');
      }
      form.reset();
    });
  });
</script>
