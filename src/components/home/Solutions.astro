---
import type { HomeSolutionsData } from '@/types';

interface Props {
  data: HomeSolutionsData;
  class?: string;
}

const { data, class: className } = Astro.props;
---

<section class:list={['bg-surface px-[20px] py-[72px] md:px-[40px]', className]}>
  <div class="mx-auto max-w-[1320px]">
    <div data-reveal-children class="mx-auto max-w-[760px] text-center">
      <p class="text-[0.78rem] leading-[1.6rem] font-semibold tracking-[0.06em] text-brand-dark uppercase">{data.eyebrow}</p>
      <h2 class="mt-[8px] font-heading leading-[1.3] font-bold text-ink">{data.title}</h2>
      <p class="mt-[12px] text-body">{data.text}</p>
    </div>

    <ul data-reveal-children class="mt-[40px] grid gap-[24px] md:grid-cols-2 xl:grid-cols-4">
      {
        data.items.map((s, i) => (
          <li>
            <article class="flex h-full flex-col overflow-hidden rounded-[8px] bg-white shadow-[4px_4px_0_rgba(36,39,43,0.08),0_2px_12px_rgba(36,39,43,0.08)]">
              <img
                src={s.image.src}
                srcset={s.image.srcset}
                sizes="(min-width: 1400px) 312px, (min-width: 1280px) calc((100vw - 152px) / 4), (min-width: 768px) calc((100vw - 104px) / 2), calc(100vw - 40px)"
                alt={s.image.alt}
                loading="lazy"
                decoding="async"
                class="block aspect-[7/5] w-full border-b-[3px] border-brand object-cover"
              />
              <div class="flex flex-1 flex-col px-[22px] pt-[20px] pb-[24px]">
                <span class="grid size-[32px] place-items-center rounded-[6px] bg-brand text-[13px] font-bold text-white" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <h3 class="mt-[18px] text-[1.2rem] leading-[1.3] text-ink">{s.title}</h3>
                <p class="mt-[10px] flex-1 text-[0.95rem] leading-[1.6] text-body">{s.text}</p>
                <a href={data.cta.href} class="mt-[18px] inline-flex items-center gap-[6px] text-[0.95rem] font-semibold text-brand-dark hover:text-brand">
                  {data.cta.label}
                  <span class="sr-only">sobre {s.title}</span>
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>
