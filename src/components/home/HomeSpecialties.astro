---
import type { HomeSpecialtiesData } from '@/types';
import BrandRule from '@/components/home/BrandRule.astro';
import { coverSrcset } from '@/data/obras';

interface Props {
  data: HomeSpecialtiesData;
}

const { data } = Astro.props;
const collage = data.collage;
// Proporciones del collage del diseño: anchos de columna y alto de la más alta (las tres miden casi lo mismo).
const columnsTemplate = collage.map((c) => `${c.width}fr`).join(' ');
const collageWidth = collage.reduce((sum, c) => sum + c.width, 0);
const collageHeight = Math.max(...collage.map((c) => c.photos.reduce((sum, p) => sum + p.height, 0)));
---

<!--
  "Nuestras Especialidades" (diseño de Tenax en Canva, pág. 10): banda grafito con collage a la izquierda y
  texto a la derecha. El collage sobresale por debajo de la banda; luego, una foto por especialidad.
-->
<section class="bg-ink px-[20px] pt-[64px] pb-[56px] lg:pt-[92px] lg:pb-0">
  <div class="mx-auto grid max-w-[1180px] gap-[48px] lg:grid-cols-[257fr_226fr] lg:items-start lg:gap-[64px]">
    <div
      class="relative z-10 grid gap-[12px] lg:-mb-[28px] lg:gap-[18px]"
      style={`grid-template-columns:${columnsTemplate};aspect-ratio:${collageWidth}/${collageHeight}`}
      aria-hidden="true"
    >
      {
        collage.map((column) => (
          <div class="flex min-h-0 flex-col gap-[12px] lg:gap-[18px]">
            {column.photos.map(({ image, height }) => (
              <div class="min-h-0 basis-0 overflow-hidden bg-dark" style={`flex-grow:${height}`}>
                <img
                  src={image.src}
                  srcset={image.srcset}
                  sizes="(min-width: 1180px) 230px, 30vw"
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class="size-full object-cover"
                />
              </div>
            ))}
          </div>
        ))
      }
    </div>

    <div data-reveal-children class="max-lg:order-first lg:pt-[64px]">
      <h2
        class="font-display text-[clamp(2.1rem,3.6vw,3.2rem)] leading-[1.1] font-semibold text-white after:mt-[18px] after:block after:h-[3px] after:w-[94px] after:bg-brand"
      >
        {data.title}
      </h2>
      <p class="mt-[32px] max-w-[520px] text-[clamp(1.05rem,1.4vw,1.25rem)] leading-[1.35] font-bold text-white">{data.lead}</p>
      <p class="mt-[24px] max-w-[520px] text-[clamp(1.05rem,1.4vw,1.25rem)] leading-[1.35] text-white">
        {data.text.map((seg) => (typeof seg === 'string' ? seg : <strong class="font-bold">{seg.highlight}</strong>))}
      </p>
    </div>
  </div>
</section>

<!--
  Una foto por especialidad en mosaico casi sin separación: cuadrícula de 3 × 2 en la que la foto "wide" ocupa
  dos casillas, así las cinco quedan alineadas. El pie va en una pestaña blanca de borde diagonal sobre la
  esquina inferior derecha de la foto.
-->
<div class="relative bg-white px-[20px] pt-[64px] pb-[72px] lg:pt-[150px]">
  <BrandRule />
  <ul data-reveal-children class="mx-auto grid max-w-[1180px] gap-[6px] sm:grid-flow-row-dense sm:grid-cols-2 lg:grid-cols-3">
    {
      data.items.map((item) => (
        <li class:list={[item.wide && 'relative sm:col-span-2']}>
          <a
            href={item.href}
            class:list={[
              'group relative block overflow-hidden bg-surface',
              // En escritorio la ancha no impone alto: rellena su casilla y la fila toma el alto de su vecina.
              item.wide ? 'aspect-[174/126] sm:aspect-[354/126] lg:absolute lg:inset-0 lg:aspect-auto' : 'aspect-[174/126]',
            ]}
          >
            <img
              src={item.image.src}
              srcset={coverSrcset(item.image, item.wide ? 354 / 126 : 174 / 126)}
              sizes={
                item.wide
                  ? '(min-width: 1220px) 786px, (min-width: 1024px) calc((100vw - 52px) * 2 / 3), calc(100vw - 40px)'
                  : '(min-width: 1220px) 390px, (min-width: 1024px) calc((100vw - 52px) / 3), (min-width: 640px) calc((100vw - 46px) / 2), calc(100vw - 40px)'
              }
              alt={item.image.alt}
              loading="lazy"
              decoding="async"
              class="size-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
              style={item.image.position ? `object-position:${item.image.position}` : undefined}
            />
            <p class="absolute right-0 bottom-0 max-w-[calc(100%-32px)] bg-white py-[10px] pr-[14px] pl-[36px] text-right text-[13px] leading-[1.3] text-ink [clip-path:polygon(24px_0,100%_0,100%_100%,0_100%)] group-hover:text-brand">
              {item.caption}
            </p>
          </a>
        </li>
      ))
    }
  </ul>
</div>
