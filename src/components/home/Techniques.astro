---
import type { HomeTechnique } from '@/types';

interface Props {
  items: HomeTechnique[];
  background: string;
}

const { items, background } = Astro.props;
---

<div class="mx-auto max-w-[1400px] px-[20px] md:px-[40px]">
  <ul data-reveal-children class="grid gap-[21px] md:grid-cols-2 md:gap-[32px] xl:grid-cols-4">
    {
      items.map((t) => (
        <li
          class="group relative isolate overflow-hidden rounded-[15px] border-2 border-black bg-[#f1f1f1] bg-cover bg-center p-[36px] text-center shadow-[0_5px_16px_0_#000] transition-colors hover:border-brand"
          style={`background-image:url(${background})`}
        >
          <div class="absolute inset-0 -z-10 bg-black opacity-80 transition-opacity group-hover:opacity-90" />
          <h4 class="font-display text-[18px] leading-[1.2] font-semibold text-brand tablet:text-[24px]">{t.title}</h4>
          <p class="mt-[24px] text-base leading-[1.65] text-white">{t.text}</p>
        </li>
      ))
    }
  </ul>
</div>
