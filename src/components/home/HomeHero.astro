---
import type { HomeHeroData } from '@/types';
import HomeButton from '@/components/home/HomeButton.astro';

interface Props {
  hero: HomeHeroData;
}

const { hero } = Astro.props;
---

<section class="relative isolate flex min-h-[640px] items-center overflow-hidden bg-ink px-[16px] py-[64px] md:min-h-[719px] md:px-[24px]">
  <!--
    Foto de fondo con prioridad alta: es lo primero que se ve. El degradado oscurece solo el lado del texto.
    La panorámica cubre una caja de alto fijo (640-719 px): se pinta a unos 1920 px de ancho en cualquier pantalla más estrecha.
  -->
  <img
    src={hero.image.src}
    srcset={hero.image.srcset}
    sizes="(min-width: 1920px) 100vw, 1920px"
    alt=""
    fetchpriority="high"
    decoding="async"
    class="absolute inset-0 -z-20 size-full object-cover"
    style={hero.image.position ? `object-position:${hero.image.position}` : undefined}
  />
  <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(0,0,0,0.78)_0%,rgba(0,0,0,0.55)_50%,rgba(0,0,0,0.2)_100%)]"></div>

  <div class="mx-auto w-full max-w-[1200px]">
    <div data-reveal-children class="md:w-2/3">
      <h1 class="font-display font-bold text-white">
        <span class="mb-[18px] block font-sans text-[0.8rem] leading-[1.5] font-semibold tracking-[0.08em] text-white/80 uppercase">{hero.kicker}</span>
        {
          hero.lines.map((line) => (
            <span class="block">
              <span class="mb-[8px] inline-block bg-brand px-[10px] py-[2px] text-[34px] leading-[1.25] box-decoration-clone md:text-[48px]">{line}</span>
            </span>
          ))
        }
      </h1>
      <p class="mt-[24px] max-w-[560px] text-base leading-normal text-white">{hero.text}</p>
      <div class="mt-[24px] flex flex-wrap gap-[12px]">
        {
          hero.buttons.map((b) => (
            <HomeButton href={b.href} variant={b.variant}>
              {b.label}
            </HomeButton>
          ))
        }
      </div>
    </div>
  </div>
</section>
