    mode: 'stroke',
    body: '<path d="M21.3 15.3a2.4 2.4 0 0 1 0 3.4l-2.6 2.6a2.4 2.4 0 0 1-3.4 0L2.7 8.7a2.41 2.41 0 0 1 0-3.4l2.6-2.6a2.41 2.41 0 0 1 3.4 0Z"/><path d="m14.5 12.5 2-2"/><path d="m11.5 9.5 2-2"/><path d="m8.5 6.5 2-2"/><path d="m17.5 15.5 2-2"/>',
  },
  'circle-check': { viewBox: '0 0 24 24', mode: 'stroke', body: '<circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>' },
};

interface Props {
  name: IconName;
  class?: string;
  size?: number;
  strokeWidth?: number;
  label?: string;
}

const { name, class: className, size = 18, strokeWidth = 2, label } = Astro.props;
const icon = icons[name];
const paint: astroHTML.JSX.SVGAttributes =
  icon.mode === 'stroke'
    ? { fill: 'none', stroke: 'currentColor', 'stroke-width': strokeWidth, 'stroke-linecap': 'round', 'stroke-linejoin': 'round' }
    : { fill: 'currentColor' };
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={icon.viewBox}
  width={size}
  height={size}
  class={className}
  aria-hidden={label ? undefined : 'true'}
  aria-label={label}
  role={label ? 'img' : undefined}
  {...paint}
  set:html={icon.body}
/>
