---
/** Iconos SVG en línea. Los de trazo heredan `currentColor`. */
export type IconName =
  | 'facebook'
  | 'linkedin'
  | 'instagram'
  | 'tiktok'
  | 'menu'
  | 'close'
  | 'chevron-up'
  | 'chevron-down'
  | 'chevron-left'
  | 'chevron-right'
  | 'arrow-right'
  | 'arrow-left'
  | 'phone'
  | 'mail'
  | 'map-pin'
  | 'chat'
  | 'check'
  | 'external';

interface IconDef {
  viewBox: string;
  body: string;
  mode: 'fill' | 'stroke';
}

const icons: Record<IconName, IconDef> = {
  facebook: {
