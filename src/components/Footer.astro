---
import { Image } from 'astro:assets'
import Facebook from '@/assets/icons/social/facebook.svg'
import Instagram from '@/assets/icons/social/instagram.svg'
import Linkedin from '@/assets/icons/social/linkedin.svg'
import TikTok from '@/assets/icons/social/tiktok.svg'

const NAVIGATION = [
  { href: '/nosotros', label: 'Nosotros' },
  { href: '/servicios', label: 'Servicios' },
  { href: '/#proyectos', label: 'Proyectos' },
  { href: '/FAQ', label: 'Preguntas frecuentes' },
  { href: '/contacto', label: 'Contacto' },
]
---

<footer class="w-full overflow-hidden rounded-t-lg bg-primary text-pure">
  <div class="grid border-y border-white/25 lg:grid-cols-[minmax(260px,1fr)_minmax(0,2fr)_minmax(260px,1fr)]">
    <div class="flex items-center border-b border-white/25 px-6 py-10 lg:border-r lg:border-b-0 xl:px-20">
      <a href="/#inicio" aria-label="Ir al inicio de Tenax Construction">
        <Image
          src="/logo-tenax.webp"
          alt="Tenax Construction"
          width={240}
          height={100}
          class="h-auto w-40 brightness-0 invert md:w-48"
          loading="lazy"
        />
      </a>
    </div>

    <nav class="flex flex-wrap items-center gap-x-8 gap-y-5 border-b border-white/25 px-6 py-10 lg:border-b-0 xl:px-16" aria-label="Navegación del pie de página">
      {
        NAVIGATION.map((link) => (
          <a href={link.href} class="font-sans text-base text-pure transition-opacity duration-200 hover:opacity-70 md:text-lg">
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-6 px-6 py-10 lg:border-l lg:border-white/25 xl:px-16">
      <a href="https://www.facebook.com/Tnaxconstruction" target="_blank" rel="noopener noreferrer" aria-label="Tenax Construction en Facebook">
        <Facebook class="h-8 w-8 text-pure" />
      </a>
      <a href="https://www.instagram.com/tenaxconstruction/" target="_blank" rel="noopener noreferrer" aria-label="Tenax Construction en Instagram">
        <Instagram class="h-8 w-8 text-pure" />
      </a>
      <a href="https://www.linkedin.com/company/tenax-construction-srl/" target="_blank" rel="noopener noreferrer" aria-label="Tenax Construction en LinkedIn">
        <Linkedin class="h-8 w-8 text-pure" />
      </a>
      <a href="https://www.tiktok.com/@tenaxconstruction" target="_blank" rel="noopener noreferrer" aria-label="Tenax Construction en TikTok">
        <TikTok class="h-8 w-8 text-pure" fill="currentColor" />
      </a>
    </div>
  </div>

  <div class="grid lg:grid-cols-[minmax(260px,1fr)_minmax(0,2fr)_minmax(260px,1fr)]">
    <div class="px-6 py-10 lg:border-r lg:border-white/25 xl:px-20">
      <p class="max-w-xs text-sm leading-relaxed text-pure/85">© 2026 Tenax Construction SRL<br />Todos los derechos reservados.</p>
    </div>

    <div class="px-6 py-10 lg:border-r lg:border-white/25 xl:px-16">
      <p class="max-w-3xl text-sm leading-relaxed text-pure/85">
        Tenax Construction promueve una cultura de trabajo segura, responsable y respetuosa para nuestro equipo, clientes y aliados.
      </p>
      <a href="/contacto" class="mt-5 inline-block text-sm font-medium text-pure underline underline-offset-4 transition-opacity duration-200 hover:opacity-70">
        Política de privacidad
      </a>
    </div>

    <div class="flex items-start px-6 py-10 xl:px-16 flex-col">
      <a href="/contacto" class="text-sm text-pure/85 transition-opacity duration-200 hover:opacity-70">Contacto y privacidad</a>
      <a href="https://www.linkedin.com/in/jhossuarodriguez/" class="text-sm text-pure/85 transition-opacity duration-200 hover:opacity-70"> Hecha con amor por <span class="font-bold underline">Jhossua Roa</span></a>
    </div>
  </div>
</footer>