---
import Grua from '@/assets/icons/grua.svg'
import Hammer from '@/assets/icons/hammer.svg'
import DumpDumper from '@/assets/icons/dumpDumper.svg'
import Measure from '@/assets/icons/measure.svg'

const SERVICE_TILES = [
  {
    id: 'excavacion',
    icon: Grua,
    title: 'Excavación',
    description:
      'Excavaciones especializadas para cimentaciones, zanjas y remoción de materiales con maquinaria de última generación.',
    span: 'md:col-span-2',
    featured: true,
  },
  {
    id: 'estructura-metalica',
    icon: Hammer,
    title: 'Estructura metálica',
    description: 'Montaje y fabricación de estructuras metálicas para edificaciones y obras civiles.',
    span: 'md:col-span-1',
  },
  {
    id: 'movimiento-tierra',
    icon: DumpDumper,
    title: 'Movimiento de Tierra',
    description: 'Nivelación de terrenos, compactación y preparación de superficies para cimentaciones.',
    span: 'md:col-span-1',
  },
  {
    id: 'hormigon-armado',
    icon: Measure,
    title: 'Hormigón armado',
    description: 'Construcción de estructuras de hormigón armado para edificaciones y obras civiles.',
    span: 'md:col-span-1',
  },
]
---

<section id="servicios-home" class="w-full bg-paper py-20 md:py-28">
  <div class="content-shell">
    <div class="services-reveal">
      <span class="font-mono text-xs uppercase tracking-[0.18em] text-slate">Lo que hacemos</span>
      <h2 class="mt-4 max-w-4xl font-display text-4xl leading-[0.95] text-ink md:text-6xl lg:text-[72px]">
        Nuestros servicios
      </h2>
    </div>

    <div class="services-grid mt-8 grid grid-cols-1 gap-5 md:grid-cols-3">
      {
        SERVICE_TILES.map((service, i) => (
          <a
            href={`/servicios/${service.id}`}
            class={`service-tile relative flex flex-col justify-between overflow-hidden rounded-lg border border-black/10 bg-paper ${service.span} ${service.featured ? 'p-9 md:p-10' : 'p-8'}`}
          >
            <span class="font-mono text-xs text-slate/60">{`0${i + 1}`}</span>

            <div class="mt-8">
              <div class="flex h-14 w-14 items-center justify-center rounded-full bg-primary/10">
                <service.icon class="h-8 w-8 text-primary" />
              </div>
              <h3 class={`mt-5 font-display leading-none text-ink ${service.featured ? 'text-3xl md:text-4xl' : 'text-2xl'}`}>
                {service.title}
              </h3>
              <p class={`mt-3 leading-relaxed text-slate ${service.featured ? 'max-w-sm text-base' : 'text-sm'}`}>
                {service.description}
              </p>
              <span class="service-link mt-5 inline-flex items-center gap-2 font-sans text-sm font-medium text-ink">
                Ver servicio
                <span aria-hidden="true" class="service-arrow">→</span>
              </span>
            </div>
          </a>
        ))
      }
    </div>

    <div class="services-reveal mt-12 flex justify-center">
      <a
        href="/servicios"
        class="inline-flex items-center gap-2 rounded-lg bg-primary px-6 py-3 font-sans text-base text-pure"
      >
        Ver más servicios
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<script>
  import { revealOnScroll, staggerOnScroll, gsap } from '@/lib/motion'

  revealOnScroll('.services-reveal')
  staggerOnScroll('.services-grid', '.service-tile')

  gsap.utils.toArray<HTMLElement>('.service-tile').forEach((tile) => {
    const icon = tile.querySelector('svg')
    const arrow = tile.querySelector('.service-arrow')

    tile.addEventListener('mouseenter', () => {
      gsap.to(tile, { y: -6, duration: 0.35, ease: 'power2.out' })
      gsap.to(icon, { rotate: -8, scale: 1.08, duration: 0.35, ease: 'power2.out' })
      gsap.to(arrow, { x: 4, duration: 0.3, ease: 'power2.out' })
    })
    tile.addEventListener('mouseleave', () => {
      gsap.to(tile, { y: 0, duration: 0.4, ease: 'power2.out' })
      gsap.to(icon, { rotate: 0, scale: 1, duration: 0.4, ease: 'power2.out' })
      gsap.to(arrow, { x: 0, duration: 0.3, ease: 'power2.out' })
    })
  })
</script>
