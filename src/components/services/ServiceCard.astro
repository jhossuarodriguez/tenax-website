---
import type { Service } from '@/types';
import { coverSrcset } from '@/data/obras';

interface Props {
  service: Service;
  /** En tablet (2 columnas) ocupa toda la fila: para la última card cuando el total es impar. */
  wide?: boolean;
}

const { service, wide = false } = Astro.props;
---

<!--
  Mismo formato que "Proyectos Destacados" del home: la foto completa y el título en una pestaña blanca de borde
  diagonal sobre la esquina inferior derecha.
-->
<a
  href={`/servicios/${service.slug}/`}
  class:list={['group relative block aspect-[174/126] overflow-hidden bg-surface', wide && 'sm:aspect-[354/126] lg:aspect-[174/126]']}
>
  <img
    src={service.image.src}
    srcset={coverSrcset(service.image, wide ? 354 / 126 : 174 / 126)}
    sizes={
      wide
        ? '(min-width: 1240px) 396px, (min-width: 1024px) calc((100vw - 52px) / 3), calc(100vw - 40px)'
        : '(min-width: 1240px) 396px, (min-width: 1024px) calc((100vw - 52px) / 3), (min-width: 640px) calc((100vw - 46px) / 2), calc(100vw - 40px)'
    }
    alt={service.image.alt}
    loading="lazy"
    decoding="async"
    class="size-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
    style={service.image.position ? `object-position:${service.image.position}` : undefined}
  />
  <p
    class="absolute right-0 bottom-0 max-w-[calc(100%-32px)] bg-white py-[10px] pr-[14px] pl-[36px] text-right text-[13px] leading-[1.3] text-ink [clip-path:polygon(24px_0,100%_0,100%_100%,0_100%)] group-hover:text-brand"
  >
    {service.title}
  </p>
</a>
