---
import type { Service } from '@/types';

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<article
  class="flex flex-col overflow-hidden rounded-[12px] border border-[#e5e5e5] bg-white shadow-card transition-[transform,box-shadow] duration-200"
>
  <div class="aspect-[16/10] w-full overflow-hidden bg-[#eee]">
    <img
      src={service.image.src}
      alt={service.image.alt}
      loading="lazy"
      decoding="async"
      class="block size-full object-cover"
      style={service.image.position ? `object-position:${service.image.position}` : undefined}
    />
  </div>
  <div class="flex flex-1 flex-col p-[24px]">
    <p class="mb-[8px] text-[0.9rem] leading-[1.6rem] font-semibold text-brand-dark">{service.tags}</p>
    <h3 class="mb-[12px] text-[1.25rem] leading-[1.3] font-bold">{service.title}</h3>
    <p class="flex-1 leading-[1.6rem] text-[#444]">{service.excerpt}</p>
    <p class="mt-[16px] leading-[1.6rem]">
      <a href={`/servicios/${service.slug}/`} class="font-bold text-brand-dark no-underline hover:text-brand-dark">Ver servicio →</a>
    </p>
  </div>
</article>
