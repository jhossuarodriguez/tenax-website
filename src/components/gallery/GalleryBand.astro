---
import type { GalleryBand } from '@/types';

interface Props {
  data: GalleryBand;
}

const { data } = Astro.props;
---

<section data-reveal-children class="bg-ink px-6 py-[58px] text-center">
  <!-- El original deja el kicker en una caja de 620px alineada a la izquierda; se conserva igual. -->
  <p class="mb-3 max-w-[620px] font-mono text-[0.78rem] leading-[1.65] font-semibold tracking-[0.05em] text-brand uppercase">{data.kicker}</p>
  <h2 class="mb-3.5 font-display text-[clamp(1.5rem,3vw,2rem)] leading-[1.3] font-bold text-cream">{data.title}</h2>
  <p class="mx-auto mb-[26px] max-w-[620px] text-[0.98rem] leading-[1.65] text-sand">{data.text}</p>
  <ul class="mx-auto flex max-w-[840px] flex-wrap justify-center gap-2.5 font-mono tracking-[0.85px]">
    {
      data.tags.map((tag) => (
        <li class="rounded-full border border-[#4a4a4a] px-4 py-2 text-[0.8rem] leading-[1.6rem] text-[#e5e5e5] transition-colors duration-150 hover:border-brand hover:bg-brand hover:text-white">
          {tag}
        </li>
      ))
    }
  </ul>
</section>
