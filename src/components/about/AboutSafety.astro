---
import type { AboutSafetyData } from '@/types';
import { coverSrcset } from '@/data/obras';

interface Props {
  data: AboutSafetyData;
}

const { data } = Astro.props;

/** Texto: 18 px (20 px en 768–1023, 16 px en < 768), como el de las filas de Nosotros. */
const body = 'text-[1rem] leading-[1.5] md:text-[1.25rem] md:leading-[1.53] lg:text-[1.125rem] lg:leading-[1.556]';
---

<!--
  "Seguridad, calidad y medio ambiente", según el diseño de Tenax en Canva (pág. 21): banda grafito a todo lo ancho
  con una sola foto vertical (4 : 5) a la izquierda que sobresale 50 px por debajo de la banda (40 px en < 1024), y
  a la derecha el título en blanco con una raya naranja, la frase destacada en negrita y el texto.
  - Contenido de 1060 px, alineado con las filas de Misión. La foto mide 400 px de ancho (≥ 1024) o el 40 %
    (640–1023) y empieza 50 px por debajo del borde superior de la banda; si el texto es más alto que ella (640–1023),
    se alinea abajo para seguir sobresaliendo.
  - En < 640 se apila: primero el texto y debajo la foto (360 px como máximo), que sigue sobresaliendo por debajo.
  - El margen inferior de la sección deja libre el tramo de foto que sobresale.
-->
<section id={data.id} class="mb-[40px] scroll-mt-[20px] bg-ink px-[20px] pt-[40px] lg:mb-[50px] lg:pt-[50px]">
  <div class="mx-auto flex max-w-[1060px] flex-col-reverse items-center sm:flex-row sm:items-start">
    <figure data-reveal class="m-0 -mb-[40px] w-full max-w-[360px] shrink-0 sm:w-[40%] sm:max-w-none sm:self-end lg:-mb-[50px] lg:w-[400px]">
      <img
        src={data.image.src}
        srcset={coverSrcset(data.image, 4 / 5)}
        sizes="(min-width: 1024px) 400px, (min-width: 640px) 40vw, (min-width: 400px) 360px, 92vw"
        alt={data.image.alt}
        width={data.image.width}
        height={data.image.height}
        loading="lazy"
        decoding="async"
        class="aspect-[4/5] w-full object-cover"
        style={data.image.position ? `object-position:${data.image.position}` : undefined}
      />
    </figure>

    <div
      data-reveal-children
      class="mx-auto w-full max-w-[360px] pb-[40px] text-white sm:mx-0 sm:max-w-none sm:min-w-0 sm:flex-1 sm:self-center sm:pb-[40px] sm:pl-[30px] lg:pl-[60px] xl:pl-[80px]"
    >
      <h2 class="mb-[16px] font-display text-[1.75rem] leading-[1.222] font-normal text-white sm:text-[2rem] sm:leading-[1.2] lg:text-[2.5rem]">
        {data.title}
      </h2>
      <span class="mb-[20px] block h-[4px] w-[70px] bg-brand" aria-hidden="true"></span>
      <p class:list={['mb-[16px] font-semibold text-white', body]}>{data.lede}</p>
      {data.paragraphs.map((p) => <p class:list={['mb-[16px] text-sand last:mb-0', body]}>{p}</p>)}
    </div>
  </div>
</section>
