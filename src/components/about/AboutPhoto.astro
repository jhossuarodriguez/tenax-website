---
import type { ImageAsset } from '@/types';
import { coverSrcset } from '@/data/obras';

interface Props {
  image: ImageAsset;
  class?: string;
}

const { image, class: className } = Astro.props;
---

<!--
  Foto de las filas de Nosotros con el mismo encuadre que la del banner (PageBanner), en una sola pieza: detrás, un
  fondo gris acero a la izquierda y naranja (brand-dark) a la derecha, partido al 47 % del ancho. La foto (467 × 428)
  deja ver una franja gris a su izquierda (19,5 % del ancho) y el fondo por arriba (40 px; 25 px en < 768). Encima,
  la banda de franjas blancas centrada en el borde superior de la foto (80 px de alto; 50 px en < 768), que acaba
  antes del borde derecho.
-->
<figure
  data-reveal
  class:list={[
    'relative m-0 w-full bg-[linear-gradient(to_right,var(--color-steel)_47%,var(--color-brand-dark)_47%)]',
    className,
  ]}
>
  <!-- El relleno va en un contenedor propio: sus porcentajes se calculan sobre el ancho de la figura y no del de la fila. -->
  <div class="pt-[25px] pr-[4px] pl-[19.5%] md:pt-[40px]">
    <img
      src={image.src}
      srcset={coverSrcset(image, 467 / 428)}
      sizes="(min-width: 1150px) 400px, (min-width: 640px) 40vw, 80vw"
      alt={image.alt}
      width={image.width}
      height={image.height}
      loading="lazy"
      decoding="async"
      class="aspect-[467/428] w-full object-cover"
      style={image.position ? `object-position:${image.position}` : undefined}
    />
  </div>
  <span class="bg-stripes absolute top-0 right-[7.4%] left-[4px] h-[50px] text-white md:h-[80px]" aria-hidden="true"></span>
</figure>
