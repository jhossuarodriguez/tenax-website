---
import { Image } from 'astro:assets'
import HandShaking from '@/assets/ui_images/handshaking.webp'
import Crane from '@/assets/ui_images/crane.webp'
import Drawing from '@/assets/ui_images/drawing.webp'

const STATS = [
  { image: Drawing, value: 80, suffix: '+', label: 'Proyectos completados' },
  { image: HandShaking, value: 80, suffix: '+', label: 'Clientes satisfechos' },
  { image: Crane, value: 13, suffix: '', label: 'Años en el mercado' },
]
---

<section id="numbers-section" class="w-full bg-mist py-20 md:py-28">
  <div class="content-shell">
    <div class="numbers-reveal">
      <span class="font-mono text-xs uppercase tracking-[0.18em] text-slate">Nuestra trayectoria</span>
      <h2 class="mt-4 max-w-4xl font-display text-4xl leading-[0.95] text-ink md:text-6xl lg:text-[72px]">
        Números que hablan
      </h2>
      <p class="mt-6 max-w-md text-base leading-relaxed text-slate md:text-lg">
        Nuestra trayectoria se refleja en números, que representan nuestro compromiso y éxito en
        el sector de la construcción.
      </p>
    </div>

    <div class="numbers-grid mt-14 grid gap-6 md:grid-cols-3">
      {
        STATS.map((stat) => (
          <div class="stat-item relative min-h-[220px] overflow-hidden rounded-lg border border-white/10">
            <Image src={stat.image} alt={stat.label} class="absolute inset-0 h-full w-full object-cover" loading="lazy" />
            <div class="absolute inset-0 bg-obsidian/60" />
            <div class="relative z-10 flex h-full min-h-[220px] flex-col items-center justify-center gap-2 p-6 text-center">
              <span
                class="font-display text-5xl text-pure"
                data-count-to={stat.value}
                data-count-suffix={stat.suffix}
              >
                {stat.value}{stat.suffix}
              </span>
              <p class="font-mono text-xs uppercase tracking-[0.16em] text-ash">{stat.label}</p>
            </div>
          </div>
        ))
      }
    </div>

    <div class="numbers-reveal mt-12 flex justify-center">
      <a
        href="/nosotros"
        class="inline-flex items-center gap-2 font-sans text-sm font-medium text-ink hover:text-slate"
      >
        Conoce nuestra historia
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<script>
  import { revealOnScroll, staggerOnScroll, countUpOnScroll } from '@/lib/motion'
  revealOnScroll('.numbers-reveal')
  staggerOnScroll('.numbers-grid', '.stat-item')
  countUpOnScroll('[data-count-to]')
</script>
