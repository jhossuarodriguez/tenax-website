---
import type { MachinerySection } from '@/types';

interface Props {
  data: MachinerySection;
}

const { data } = Astro.props;
---

<section class="bg-ink">
  <div class="mx-auto max-w-[1120px] px-6 pt-[62px] pb-[70px]">
    <p data-reveal class="mb-[21px] font-mono text-[0.78rem] leading-[1.6rem] font-semibold tracking-[0.05em] text-brand uppercase">{data.kicker}</p>
    <h2 data-reveal class="mb-3.5 font-display text-[clamp(1.5rem,3vw,2rem)] leading-[1.3] font-bold text-cream">{data.title}</h2>
    <p data-reveal class="mb-[27px] max-w-[660px] text-base leading-[1.65] text-sand">{data.description}</p>

    <div data-reveal-children class="grid grid-cols-2 gap-4 min-[901px]:grid-cols-4">
      {
        data.items.map((item) => (
          <figure class="group overflow-hidden rounded border border-white/14 bg-black transition-[border-color,transform] duration-200 hover:-translate-y-1 hover:border-brand">
            <img
              src={item.image.src}
              alt={item.image.alt}
              loading="lazy"
              decoding="async"
              class="block aspect-[3/4] w-full object-cover opacity-92 transition-[transform,opacity] duration-500 group-hover:scale-105 group-hover:opacity-100"
            />
            <figcaption class="border-t border-white/12 px-3 py-2.5 font-mono text-[0.72rem] leading-[1.6rem] tracking-[0.05em] text-stone-2 uppercase">
              {item.caption}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
