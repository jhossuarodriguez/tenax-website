---
import type { MachinerySection } from '@/types';
import { coverSrcset } from '@/data/obras';

interface Props {
  data: MachinerySection;
}

const { data } = Astro.props;

/** Une con espacio duro las cifras y unidades al resto del modelo, para que "7 m³" o "125 kVA" no se partan. */
const keepUnits = (text: string) => text.replace(/ (?=\d|m³|kVA|CFM)/g, '\u00a0');

const button =
  'cursor-pointer rounded-[4px] border border-white/45 bg-ink-2 px-[16px] py-[9px] text-[0.82rem] leading-[1.2] text-white transition-colors duration-200 whitespace-nowrap hover:border-brand aria-pressed:border-brand aria-pressed:bg-brand xl:flex-auto xl:px-[12px]';
---

<!--
  Maquinaria de Tenax según el diseño en Canva (pág. 31), sobre el grafito de siempre:
  - Botones de categoría arriba, redondeados y repartidos a todo el ancho (en < 1280 pasan a varias líneas):
    "Todos los equipos" activo en naranja; el resto oscuros con borde gris. Filtran la cuadrícula sin recargar (sin
    JavaScript se ven todas las máquinas y los botones quedan ocultos).
  - Cuadrícula de 4 columnas (3 en < 1280, 2 en < 1024, 1 en < 640) con la foto de cada máquina (16 : 10) y, en la esquina inferior
    derecha, un recuadro grafito con el borde izquierdo en diagonal y el nombre en dos líneas sin partir: el tipo y la
    marca y modelo. El recuadro crece con el nombre más largo (58–88 % del ancho). Cada tarjeta abre la ficha
    técnica de su máquina (/equipos/{slug}/).
-->
<section class="bg-ink">
  <div class="mx-auto max-w-[1120px] px-6 pt-[62px] pb-[70px]">
    <p data-reveal class="mb-[21px] font-mono text-[0.78rem] leading-[1.6rem] font-semibold tracking-[0.05em] text-brand uppercase">{data.kicker}</p>
    <h2 data-reveal class="mb-3.5 font-display text-[clamp(1.5rem,3vw,2rem)] leading-[1.3] font-bold text-cream">{data.title}</h2>
    <p data-reveal class="mb-[27px] max-w-[660px] text-base leading-[1.65] text-sand">{data.description}</p>

    <div data-machine-filters role="group" aria-label="Filtrar por categoría" class="mb-[26px] hidden flex-wrap gap-[10px] xl:flex-nowrap">
      <button type="button" data-filter="" aria-pressed="true" class={button}>{data.allLabel}</button>
      {
        data.categories.map((c) => (
          <button type="button" data-filter={c.id} aria-pressed="false" class={button}>
            {c.label}
          </button>
        ))
      }
    </div>

    <ul data-reveal-children class="grid gap-[16px] sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {
        data.machines.map((m) => (
          <li data-category={m.category}>
            <a href={m.href} class="group relative block overflow-hidden rounded-[3px] bg-black">
              <img
                src={m.image.src}
                srcset={coverSrcset(m.image, 16 / 10)}
                sizes="(min-width: 1280px) 256px, (min-width: 1024px) calc((100vw - 80px) / 3), (min-width: 640px) calc(50vw - 32px), calc(100vw - 48px)"
                alt=""
                loading="lazy"
                decoding="async"
                class="block aspect-[16/10] w-full object-cover transition-[scale] duration-500 group-hover:scale-105"
              />
              <span class="absolute right-0 bottom-0 flex min-h-[36%] max-w-[88%] min-w-[58%] flex-col items-end justify-center bg-ink/95 py-[10px] pr-[14px] pl-[36px] text-right text-[0.9rem] leading-[1.3] whitespace-nowrap text-white [clip-path:polygon(28px_0,100%_0,100%_100%,0_100%)] xl:text-[0.84rem]">
                <span>{m.type}</span>
                <span>{keepUnits(m.model)}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-machine-filters]').forEach((filters) => {
    const section = filters.closest('section');
    const items = [...(section?.querySelectorAll<HTMLElement>('[data-category]') ?? [])];
    const buttons = [...filters.querySelectorAll<HTMLButtonElement>('[data-filter]')];

    buttons.forEach((button) =>
      button.addEventListener('click', () => {
        const id = button.dataset.filter;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
        items.forEach((item) => (item.hidden = Boolean(id) && item.dataset.category !== id));
      }),
    );

    filters.classList.replace('hidden', 'flex');
  });
</script>
